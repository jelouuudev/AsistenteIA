@model IEnumerable<Asistente.Shared.UsuarioDto>
@{
    ViewData["Title"] = "Usuarios a Autorizar";
}
<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-people me-2"></i>Usuarios — Control de Acceso</h2>
    <p class="text-secondary">Seleccione un usuario para asignarle asistentes y fuentes de conocimiento autorizados.</p>
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover">
            <thead><tr><th>ID</th><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.IdUsuario</td>
                    <td>@u.UsuarioNombre</td>
                    <td>@u.Nombres @u.Apellidos</td>
                    <td><span class="badge bg-info">@(string.Join(", ", u.Roles))</span></td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Seguridad" asp-action="AsignarAsistentes" asp-route-idUsuario="@u.IdUsuario">
                            <i class="bi bi-robot me-1"></i>Asignar Asistentes
                        </a>
                        <a class="btn btn-sm btn-outline-success" asp-controller="Seguridad" asp-action="AsignarFuentes" asp-route-idUsuario="@u.IdUsuario">
                            <i class="bi bi-database me-1"></i>Asignar Fuentes
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
