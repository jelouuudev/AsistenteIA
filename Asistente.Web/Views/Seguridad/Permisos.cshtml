@model IEnumerable<Asistente.Shared.PermisoDto>
@{
    ViewData["Title"] = "Permisos";
    var roles = (List<Asistente.Shared.RolDto>)(ViewBag.Roles ?? new List<Asistente.Shared.RolDto>());
    int? idRol = (int?)ViewBag.IdRol;
    var matriz = (List<Asistente.Shared.PermisoAsignadoDto>)(ViewBag.Matriz ?? new List<Asistente.Shared.PermisoAsignadoDto>());
}
<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-key me-2"></i>Permisos por Módulo</h2>
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover">
            <thead><tr><th>Código</th><th>Nombre</th><th>Módulo</th><th>Descripción</th><th>Activo</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><code>@p.Codigo</code></td>
                    <td>@p.Nombre</td>
                    <td><span class="badge bg-secondary">@p.Modulo</span></td>
                    <td>@p.Descripcion</td>
                    <td>@(p.Activo ? "Sí" : "No")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h3 class="mt-5 mb-1"><i class="bi bi-shield-check me-2"></i>Asignación por Rol</h3>
    <p class="text-secondary small mb-3">Elige un rol para ver y editar sus permisos. Aplica de inmediato (excepto Administrador, que siempre tiene acceso total).</p>
    <div class="d-flex gap-2 flex-wrap mb-4">
        @foreach (var r in roles)
        {
            <a asp-action="Permisos" asp-route-idRol="@r.IdRol"
               class="btn btn-sm @(idRol == r.IdRol ? "btn-primary" : "btn-outline-light")">@r.Nombre</a>
        }
    </div>
    @if (idRol.HasValue)
    {
        var grupos = matriz.Select((p, i) => new { p, i }).GroupBy(x => x.p.Modulo).OrderBy(g => g.Key).ToList();
        var nombreRol = roles.FirstOrDefault(r => r.IdRol == idRol.Value)?.Nombre ?? "";
        @if (nombreRol == "Administrador")
        {
            <div class="alert alert-warning border-0" style="background:rgba(251,191,36,0.15);color:#fcd34d;border-radius:12px;">
                <i class="bi bi-exclamation-triangle me-2"></i><strong>Cuidado:</strong> la matriz manda para todos, incluido Administrador.
                Si desmarcas algo aquí te lo denegará a ti también (ej. sin <code>AUDITORIA_CONSULTAR</code> no verás el Dashboard).
            </div>
        }
        <form method="post" asp-action="AsignarPermisos" asp-route-idRol="@idRol.Value" onsubmit="return confirm('¿Guardar esta asignación de permisos?');">
            @foreach (var g in grupos)
            {
                <h5 class="mt-3 mb-2"><span class="badge" style="background:rgba(99,102,241,0.2);color:#a5b4fc;border-radius:8px;">@g.Key</span></h5>
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead><tr><th style="width:60px;">Asignado</th><th>Código</th><th>Nombre</th></tr></thead>
                        <tbody>
                        @foreach (var x in g)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="[@x.i].Asignado" value="true" @(matriz[x.i].Asignado ? "checked" : "") />
                                </td>
                                <td><code style="color:#818cf8;">@matriz[x.i].Codigo</code></td>
                                <td>@matriz[x.i].Nombre</td>
                            </tr>
                            <input type="hidden" name="[@x.i].IdPermiso" value="@matriz[x.i].IdPermiso" />
                            <input type="hidden" name="[@x.i].Codigo" value="@matriz[x.i].Codigo" />
                            <input type="hidden" name="[@x.i].Nombre" value="@matriz[x.i].Nombre" />
                            <input type="hidden" name="[@x.i].Modulo" value="@matriz[x.i].Modulo" />
                        }
                        </tbody>
                    </table>
                </div>
            }
            <button type="submit" class="btn btn-primary mt-2"><i class="bi bi-save me-1"></i>Guardar asignaciones</button>
        </form>
    }
</div>
