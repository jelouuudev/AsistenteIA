@model IEnumerable<Asistente.Shared.PermisoDto>
@{
    ViewData["Title"] = "Permisos";
}
<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-key me-2"></i>Permisos por Módulo</h2>
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover">
            <thead><tr><th>Código</th><th>Nombre</th><th>Módulo</th><th>Descripción</th><th>Activo</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><code>@p.Codigo</code></td>
                    <td>@p.Nombre</td>
                    <td><span class="badge bg-secondary">@p.Modulo</span></td>
                    <td>@p.Descripcion</td>
                    <td>@(p.Activo ? "Sí" : "No")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
