@model List<Asistente.Shared.FuenteAutorizadaDto>
@{
    ViewData["Title"] = "Asignar Fuentes";
    int idUsuario = (int)ViewBag.IdUsuario;
}
<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-book me-2"></i>Asignar Fuentes de Conocimiento al Usuario #@idUsuario</h2>
    <form method="post" asp-action="AsignarFuentes" asp-route-idUsuario="@idUsuario">
        <div class="table-responsive">
            <table class="table table-dark table-hover">
                <thead><tr><th>#</th><th>Fuente</th><th>Autorizada</th></tr></thead>
                <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var marcada = Model[i].Autorizada;
                    <tr>
                        @* Mismo prefijo "items[]" que en AsignarAsistentes: sin el,
                           el binding devolvia null y al guardar se perdian todas las
                           fuentes asignadas al usuario. *@
                        <td>
                            <input type="hidden" name="items[@i].Autorizada" value="false" />
                            <input class="form-check-input" type="checkbox" name="items[@i].Autorizada" value="true" checked="@(marcada ? "checked" : null)" />
                        </td>
                        <td>@Model[i].Nombre</td>
                        <td>
                            <input type="hidden" name="items[@i].IdFuente" value="@Model[i].IdFuente" />
                            <input type="hidden" name="items[@i].Nombre" value="@Model[i].Nombre" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar asignaciones</button>
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
