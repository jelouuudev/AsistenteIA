@model List<Asistente.Shared.AsistenteAutorizadoDto>
@{
    ViewData["Title"] = "Asignar Asistentes";
    int idUsuario = (int)ViewBag.IdUsuario;
}
<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-robot me-2"></i>Asignar Asistentes al Usuario #@idUsuario</h2>
    <p class="text-secondary small mb-3">El check es asignación <strong>directa</strong>. La columna <strong>Por rol</strong> muestra si igual entra por sus roles — quitar el check no bloquea en ese caso.</p>
    <form method="post" asp-action="AsignarAsistentes" asp-route-idUsuario="@idUsuario">
        <div class="table-responsive">
            <table class="table table-dark table-hover">
                <thead><tr><th>#</th><th>Asistente</th><th>Por rol</th><th>Autorizado</th></tr></thead>
                <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var marcado = Model[i].Autorizado;
                    <tr>
                        @* El prefijo "items[]" es OBLIGATORIO: la accion recibe
                           List<AsistenteAutorizadoDto> items, y el binder solo
                           encuentra lo que viene con ese nombre. Con Html.CheckBoxFor
                           los campos salian como "[0].Autorizado" (sin prefijo), el
                           binding devolvia null y al guardar se aplicaba un
                           "borrar todo y reasignar" con lista vacia: se perdian
                           todas las asignaciones del usuario. *@
                        <td>
                            <input type="hidden" name="items[@i].Autorizado" value="false" />
                            <input class="form-check-input" type="checkbox" name="items[@i].Autorizado" value="true" checked="@(marcado ? "checked" : null)" />
                        </td>
                        <td>@Model[i].Nombre</td>
                        <td>
                            @if (Model[i].RolesQueOtorgan.Any())
                            {
                                <span class="badge" style="background:rgba(251,191,36,0.15);color:#fcd34d;border-radius:20px;">@string.Join(", ", Model[i].RolesQueOtorgan)</span>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td>
                            <input type="hidden" name="items[@i].IdAsistente" value="@Model[i].IdAsistente" />
                            <input type="hidden" name="items[@i].Nombre" value="@Model[i].Nombre" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar asignaciones</button>
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
