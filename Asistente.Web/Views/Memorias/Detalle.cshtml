@model Asistente.Shared.MemoryDto
@{
    ViewData["Title"] = $"Memoria {Model.Codigo}";
    var versiones = ViewBag.Versiones as System.Collections.Generic.IEnumerable<Asistente.Shared.MemoryVersionDto>
        ?? new System.Collections.Generic.List<Asistente.Shared.MemoryVersionDto>();
    var auditoria = ViewBag.Auditoria as System.Collections.Generic.IEnumerable<Asistente.Shared.MemoryAccessLogDto>
        ?? new System.Collections.Generic.List<Asistente.Shared.MemoryAccessLogDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0">
            <i class="bi bi-journal-bookmark me-2" style="color:#818cf8;"></i>@Model.Titulo
            <small class="text-secondary">· <code>@Model.Codigo</code> · v@(Model.VersionActual)</small>
        </h4>
        <p class="text-secondary small mb-0">@Model.Ambito · @(Model.Activo ? "Activa" : "Inactiva") · @(Model.Indexada ? "indexada" : "sin índice")</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="Eliminar" asp-route-id="@Model.Codigo" method="post" class="d-inline"
              onsubmit="return confirm('¿Eliminar (o desactivar según trazabilidad)?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
        </form>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["OkMessage"] != null)
{
    <div class="alert alert-success">@TempData["OkMessage"]</div>
}

<div class="card border-0 mb-4" style="background:rgba(255,255,255,0.03);border-radius:16px;">
    <div class="card-body">
        <h6 class="text-white mb-2"><i class="bi bi-file-text me-2"></i>Contenido actual</h6>
        <pre class="text-white-50 small" style="white-space:pre-wrap;">@Model.Contenido</pre>
        <p class="text-secondary small mb-3">Expira: @(Model.FechaExpiracion?.ToString("dd/MM/yyyy") ?? "sin vencimiento") · Actualizada: @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</p>
        <h6 class="text-white mb-2"><i class="bi bi-pencil me-2"></i>Nueva versión</h6>
        <form asp-action="Actualizar" asp-route-id="@Model.Codigo" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-12">
                <textarea name="contenido" class="form-control form-control-sm font-monospace" rows="4" placeholder="Nuevo contenido (genera v@(Model.VersionActual + 1))"></textarea>
            </div>
            <div class="col-md-9">
                <input name="motivo" class="form-control form-control-sm" placeholder="Motivo del cambio (opcional)" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">Guardar v@(Model.VersionActual + 1)</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 h-100" style="background:rgba(255,255,255,0.03);border-radius:16px;">
            <div class="card-body">
                <h6 class="text-white mb-3"><i class="bi bi-clock-history me-2"></i>Versiones (@versiones.Count())</h6>
                @foreach (var v in versiones.OrderByDescending(x => x.Numero))
                {
                    <div class="border-bottom border-secondary pb-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-white">v@v.Numero</strong>
                            <small class="text-secondary">@v.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(v.Motivo))
                        {
                            <div class="text-secondary small">@v.Motivo</div>
                        }
                        <pre class="text-white-50 small mt-1" style="white-space:pre-wrap;max-height:120px;overflow:auto;">@v.Contenido</pre>
                        @if (v.Numero != Model.VersionActual)
                        {
                            <form asp-action="Revertir" asp-route-id="@Model.Codigo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="numero" value="@v.Numero" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">Revertir a v@v.Numero</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 h-100" style="background:rgba(255,255,255,0.03);border-radius:16px;">
            <div class="card-body p-0">
                <h6 class="text-white p-3 mb-0"><i class="bi bi-journal-text me-2"></i>Auditoría</h6>
                <table class="table table-dark table-hover mb-0 small">
                    <thead>
                        <tr>
                            <th>Fecha (UTC)</th>
                            <th>Operación</th>
                            <th>Resultado</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in auditoria)
                        {
                            <tr>
                                <td class="text-nowrap">@e.Fecha.ToString("dd/MM HH:mm:ss")</td>
                                <td>@e.Operacion</td>
                                <td>
                                    @if (e.Resultado == "Exitoso")
                                    {
                                        <span class="badge bg-success">Exitoso</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@e.Resultado</span>
                                    }
                                </td>
                                <td class="text-warning">@e.Motivo</td>
                            </tr>
                        }
                        @if (!auditoria.Any())
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">Sin eventos.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
