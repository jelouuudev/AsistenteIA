@model Asistente.Shared.ConfiguracionRAGDto
@{
    ViewData["Title"] = "Configuracion RAG";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-gear me-2" style="color:#818cf8;"></i>Configuracion del Motor RAG</h4>
        <p class="text-secondary small mb-0">Parametros de recuperacion y busqueda semantica</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-4">
        <form asp-action="Guardar" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background:rgba(0,0,0,0.2);">
                        <h6 class="text-white mb-3"><i class="bi bi-search me-2" style="color:#818cf8;"></i>Busqueda</h6>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Maximo de Chunks (Top-K)</label>
                            <input type="number" name="MaxChunks" value="@Model.MaxChunks" class="form-control" min="1" max="50"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Cantidad maxima de fragmentos recuperados por consulta.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Puntaje Minimo de Similitud</label>
                            <input type="number" name="MinScore" value="@Model.MinScore" class="form-control" min="0" max="1" step="0.05"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Score minimo para considerar un fragmento relevante (0-1).</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Top-K por Fuente</label>
                            <input type="number" name="TopKPorFuente" value="@Model.TopKPorFuente" class="form-control" min="1" max="20"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Maximo de fragmentos a recuperar de cada fuente.</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background:rgba(0,0,0,0.2);">
                        <h6 class="text-white mb-3"><i class="bi bi-file-earmark-text me-2" style="color:#a855f7;"></i>Contexto</h6>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Maximo de Caracteres en Contexto</label>
                            <input type="number" name="MaxCaracteresContexto" value="@Model.MaxCaracteresContexto" class="form-control" min="1000" max="50000" step="500"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Longitud maxima del contexto enviado al modelo.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Maximo de Chunks al Modelo</label>
                            <input type="number" name="MaxChunksAlModelo" value="@Model.MaxChunksAlModelo" class="form-control" min="1" max="50"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Cantidad maxima de fragmentos incluidos en el prompt.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Maximo de Referencias</label>
                            <input type="number" name="MaxReferencias" value="@Model.MaxReferencias" class="form-control" min="1" max="50"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Maximo de referencias documentales mostradas al usuario.</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background:rgba(0,0,0,0.2);">
                        <h6 class="text-white mb-3"><i class="bi bi-diagram-3 me-2" style="color:#10b981;"></i>Fuentes</h6>
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Maximo de Fuentes Consultadas</label>
                            <input type="number" name="MaxFuentesConsultadas" value="@Model.MaxFuentesConsultadas" class="form-control" min="1" max="20"
                                   style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);color:white;border-radius:10px;" />
                            <div class="form-text text-secondary" style="font-size:0.7rem;">Cantidad maxima de fuentes a consultar simultaneamente.</div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="UsarDocumentosHistoricos" value="true" id="chkHistoricos"
                                       @(Model.UsarDocumentosHistoricos ? "checked" : "") />
                                <label class="form-check-label text-secondary small" for="chkHistoricos">
                                    Incluir documentos historicos/obsoletos
                                </label>
                                <div class="form-text text-secondary" style="font-size:0.7rem;">Si esta activo, se consideraran versiones antiguas de documentos.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn px-4 py-2 fw-semibold"
                        style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
                    <i class="bi bi-save me-1"></i> Guardar Configuracion
                </button>
            </div>
        </form>
    </div>
</div>
