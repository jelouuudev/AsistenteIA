@model Asistente.Shared.ConectorDto
@{
    ViewData["Title"] = $"Conector {Model.Codigo}";
    var metricas = ViewBag.Metricas as Asistente.Shared.ConnectorMetricas;
    var auditoria = ViewBag.Auditoria as System.Collections.Generic.IEnumerable<Asistente.Shared.ConectorEjecucionDto>
        ?? new System.Collections.Generic.List<Asistente.Shared.ConectorEjecucionDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0">
            <i class="bi bi-plug me-2" style="color:#818cf8;"></i>@Model.Nombre
            <small class="text-secondary">· <code>@Model.Codigo</code></small>
        </h4>
        <p class="text-secondary small mb-0">@Model.Tipo · @(Model.Activo ? "Activo" : "Deshabilitado")</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="Probar" asp-route-id="@Model.Codigo" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-info btn-sm"><i class="bi bi-lightning me-1"></i>Probar conexión</button>
        </form>
        <form asp-action="CambiarEstado" asp-route-id="@Model.Codigo" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="activo" value="@((!Model.Activo).ToString().ToLower())" />
            <button type="submit" class="btn btn-sm @(Model.Activo ? "btn-outline-danger" : "btn-outline-success")">
                @(Model.Activo ? "Deshabilitar" : "Habilitar")
            </button>
        </form>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["OkMessage"] != null)
{
    <div class="alert alert-success">@TempData["OkMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(99,102,241,0.15);border-radius:16px;">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#818cf8;">@(metricas?.Total ?? 0)</div>
                <div class="text-secondary small">Llamadas totales</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(16,185,129,0.15);border-radius:16px;">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#6ee7b7;">@(metricas?.Exitosas ?? 0)</div>
                <div class="text-secondary small">Exitosas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(239,68,68,0.15);border-radius:16px;">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#fca5a5;">@(metricas?.Fallidas ?? 0)</div>
                <div class="text-secondary small">Fallidas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(251,191,36,0.15);border-radius:16px;">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#fcd34d;">@($"{(metricas?.LatenciaPromedioMs ?? 0):F0}ms")</div>
                <div class="text-secondary small">Latencia promedio (máx @($"{(metricas?.LatenciaMaxMs ?? 0):F0}ms"))</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 mb-4" style="background:rgba(255,255,255,0.03);border-radius:16px;">
    <div class="card-body">
        <h6 class="text-white mb-3"><i class="bi bi-gear me-2"></i>Configuración (sin secretos)</h6>
        <dl class="row mb-0 small">
            <dt class="col-sm-3 text-secondary">Tipo</dt>
            <dd class="col-sm-9 text-white">@Model.Tipo</dd>
            <dt class="col-sm-3 text-secondary">Credencial</dt>
            <dd class="col-sm-9 text-white">@(Model.TipoCredencial ?? "None") @(Model.TieneCredencial ? "(configurada)" : "(sin configurar)")</dd>
            @foreach (var kv in Model.Configuracion)
            {
                <dt class="col-sm-3 text-secondary"><code>@kv.Key</code></dt>
                <dd class="col-sm-9 text-white">@kv.Value</dd>
            }
        </dl>
    </div>
</div>

<div class="card border-0 mb-4" style="background:rgba(255,255,255,0.03);border-radius:16px;">
    <div class="card-body">
        <h6 class="text-white mb-3"><i class="bi bi-play me-2"></i>Ejecutar llamada</h6>
        <form asp-action="Ejecutar" asp-route-id="@Model.Codigo" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <input name="operacion" class="form-control form-control-sm" placeholder="Operación (ej. Aviso demo)" />
            </div>
            <div class="col-md-4">
                <input name="recurso" class="form-control form-control-sm" placeholder="Recurso o destinatario" />
            </div>
            <div class="col-md-2">
                <select name="metodo" class="form-select form-select-sm">
                    <option>GET</option>
                    <option>POST</option>
                    <option>PUT</option>
                    <option>PATCH</option>
                    <option>DELETE</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-play-fill me-1"></i>Ejecutar</button>
            </div>
            <div class="col-md-6">
                <textarea name="cuerpo" class="form-control form-control-sm" rows="2" placeholder="Cuerpo (texto o JSON)"></textarea>
            </div>
            <div class="col-md-6">
                <textarea name="parametros" class="form-control form-control-sm" rows="2" placeholder="Parámetros, uno por línea: clave=valor (ej. Asunto=Reporte)"></textarea>
            </div>
        </form>
    </div>
</div>

<div class="card border-0" style="background:rgba(255,255,255,0.03);border-radius:16px;">
    <div class="card-body p-0">
        <h6 class="text-white p-3 mb-0"><i class="bi bi-journal-text me-2"></i>Auditoría (últimas @auditoria.Count())</h6>
        <table class="table table-dark table-hover mb-0 small">
            <thead>
                <tr>
                    <th>Fecha (UTC)</th>
                    <th>Estado</th>
                    <th>Operación</th>
                    <th>Destino</th>
                    <th>Cód.</th>
                    <th>Latencia</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in auditoria)
                {
                    <tr>
                        <td class="text-nowrap">@e.Fecha.ToString("dd/MM HH:mm:ss")</td>
                        <td>
                            @if (e.Estado == "Exitoso")
                            {
                                <span class="badge bg-success">Exitoso</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@e.Estado</span>
                            }
                        </td>
                        <td>@e.Operacion</td>
                        <td><code>@e.Destino</code></td>
                        <td>@e.CodigoRespuesta</td>
                        <td>@e.LatenciaMs ms</td>
                        <td class="text-warning">@e.Error</td>
                    </tr>
                }
                @if (!auditoria.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Sin ejecuciones registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
