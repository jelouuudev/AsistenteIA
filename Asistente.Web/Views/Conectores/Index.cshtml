@model List<Asistente.Shared.ConectorDto>
@{
    ViewData["Title"] = "Conectores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-plug me-2" style="color:#818cf8;"></i>API Gateway · Conectores</h4>
        <p class="text-secondary small mb-0">Conectores externos registrados (ETAPA 20)</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Registrar</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["OkMessage"] != null)
{
    <div class="alert alert-success">@TempData["OkMessage"]</div>
}

<div class="card border-0" style="background:rgba(255,255,255,0.03);border-radius:16px;">
    <div class="card-body p-0">
        <table class="table table-dark table-hover mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Permiso</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><code>@c.Codigo</code></td>
                        <td>@c.Nombre</td>
                        <td><span class="badge bg-secondary">@c.Tipo</span></td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deshabilitado</span>
                            }
                        </td>
                        <td>
                            @if (c.RequierePermiso)
                            {
                                <span class="badge bg-warning text-dark" title="Requiere CONNECTOR:@c.Codigo">CONNECTOR:@c.Codigo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Abierto</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@c.Codigo" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">Sin conectores registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
