@model Asistente.Shared.DashboardFuentesDto
@{
    ViewData["Title"] = "Dashboard de Fuentes de Conocimiento";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none" style="color:#818cf8;"><i class="bi bi-arrow-left me-1"></i>Volver a Fuentes</a>
    <h4 class="text-white fw-bold mt-2"><i class="bi bi-speedometer2 me-2" style="color:#10b981;"></i>Dashboard de Fuentes de Conocimiento</h4>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(99,102,241,0.15);border-radius:16px;border:1px solid rgba(99,102,241,0.2);">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#818cf8;">@Model.TotalFuentes</div>
                <div class="text-secondary small">Total Fuentes</div>
                <div class="text-secondary" style="font-size:0.7rem;">@Model.TotalFuentesActivas activas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(16,185,129,0.15);border-radius:16px;border:1px solid rgba(16,185,129,0.2);">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#6ee7b7;">@Model.TotalDocumentosAsociados</div>
                <div class="text-secondary small">Documentos Asociados</div>
                <div class="text-secondary" style="font-size:0.7rem;">@Model.TotalAsistentesConFuentes asistentes</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(168,85,247,0.15);border-radius:16px;border:1px solid rgba(168,85,247,0.2);">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold" style="color:#c084fc;">@Model.TotalChunks</div>
                <div class="text-secondary small">Chunks en Vector Store</div>
                <div class="text-secondary" style="font-size:0.7rem;">@Model.TotalVectores vectores</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0" style="background:rgba(251,191,36,0.15);border-radius:16px;border:1px solid rgba(251,191,36,0.2);">
            <div class="card-body text-center py-4">
                @if (Model.FechaUltimaIndexacionGlobal.HasValue)
                {
                    <div class="fs-5 fw-bold" style="color:#fcd34d;">@Model.FechaUltimaIndexacionGlobal.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                }
                else
                {
                    <div class="fs-5 fw-bold text-secondary">N/A</div>
                }
                <div class="text-secondary small">Ultima Indexacion</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Fuente</th>
                        <th class="text-secondary fw-normal py-3">Tipo</th>
                        <th class="text-secondary fw-normal py-3">Prioridad</th>
                        <th class="text-secondary fw-normal py-3">Documentos</th>
                        <th class="text-secondary fw-normal py-3">Asistentes</th>
                        <th class="text-secondary fw-normal py-3">Chunks</th>
                        <th class="text-secondary fw-normal py-3">Vectores</th>
                        <th class="text-secondary fw-normal py-3">Ultima Indexacion</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Fuentes)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3 text-white fw-semibold">@f.Nombre</td>
                            <td class="text-secondary small">@f.Tipo</td>
                            <td class="text-center"><span class="badge bg-warning text-dark rounded-pill">@f.Prioridad</span></td>
                            <td class="text-center text-secondary">@f.TotalDocumentos</td>
                            <td class="text-center text-secondary">@f.TotalAsistentes</td>
                            <td class="text-center"><span class="badge" style="background:rgba(168,85,247,0.2);color:#c084fc;border-radius:20px;font-size:0.72rem;padding:3px 10px;">@f.TotalChunks</span></td>
                            <td class="text-center"><span class="badge" style="background:rgba(99,102,241,0.2);color:#a5b4fc;border-radius:20px;font-size:0.72rem;padding:3px 10px;">@f.TotalVectores</span></td>
                            <td class="text-secondary small">
                                @if (f.FechaUltimaIndexacion.HasValue)
                                {
                                    @f.FechaUltimaIndexacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-secondary opacity-50">Sin indexar</span>
                                }
                            </td>
                            <td>
                                @if (f.Activo)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border-radius:20px;padding:4px 10px;">Activo</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#fca5a5;border-radius:20px;padding:4px 10px;">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
