@model IEnumerable<Asistente.Shared.AsistenteDto>
@{
    ViewData["Title"] = $"Asistentes - {ViewBag.FuenteNombre}";
    var fuentesAsistente = ViewBag.FuentesAsistente as IEnumerable<Asistente.Shared.AsistenteFuenteDto> ?? Enumerable.Empty<Asistente.Shared.AsistenteFuenteDto>();
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none" style="color:#818cf8;"><i class="bi bi-arrow-left me-1"></i>Volver a Fuentes</a>
    <h4 class="text-white fw-bold mt-2"><i class="bi bi-robot me-2" style="color:#fcd34d;"></i>Asociar Asistentes a: @ViewBag.FuenteNombre</h4>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border-radius:12px;">
        @TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Asistente</th>
                        <th class="text-secondary fw-normal py-3">Modelo</th>
                        <th class="text-secondary fw-normal py-3">Asociado</th>
                        <th class="text-secondary fw-normal py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var asociado = fuentesAsistente.Any(f => f.IdAsistente == a.IdAsistente && f.Activo);
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                                         style="width:36px;height:36px;background:linear-gradient(135deg,#6366f1,#a855f7);font-weight:bold;font-size:0.9rem;">
                                        @a.Nombre[0].ToString().ToUpper()
                                    </div>
                                    <span class="fw-semibold text-white">@a.Nombre</span>
                                </div>
                            </td>
                            <td><span class="badge" style="background:rgba(129,140,248,0.2);color:#a5b4fc;border-radius:20px;font-size:0.72rem;padding:3px 10px;">@a.ModeloIA</span></td>
                            <td>
                                @if (asociado)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-check-circle me-1"></i>Asociado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(107,114,128,0.2);color:#9ca3af;border-radius:20px;padding:4px 10px;">No asociado</span>
                                }
                            </td>
                            <td class="text-end px-4">
                                @if (asociado)
                                {
                                    <form asp-action="DesasignarAsistente" method="post" class="d-inline"
                                          onsubmit="return confirm('Desasignar esta fuente del asistente?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idFuente" value="@ViewBag.FuenteId" />
                                        <input type="hidden" name="idAsistente" value="@a.IdAsistente" />
                                        <button type="submit" class="btn btn-sm"
                                                style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;">
                                            <i class="bi bi-x-circle me-1"></i>Desasignar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="AsignarAsistente" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idFuente" value="@ViewBag.FuenteId" />
                                        <input type="hidden" name="idAsistente" value="@a.IdAsistente" />
                                        <button type="submit" class="btn btn-sm"
                                                style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2);border-radius:8px;">
                                            <i class="bi bi-plus-circle me-1"></i>Asociar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
