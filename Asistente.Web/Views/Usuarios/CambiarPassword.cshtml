@model Asistente.Shared.CambiarPasswordRequest
@{
    ViewData["Title"] = "Cambiar Contraseña";
    var userId = (int)(ViewBag.UserId ?? 0);
    var username = (string)(ViewBag.Username ?? "");
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm me-3" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-key me-2" style="color:#fcd34d;"></i>Cambiar Contraseña</h4>
        <p class="text-secondary small mb-0">Usuario: <span class="text-white">@username</span></p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 p-4" style="background:rgba(30,41,59,0.7);backdrop-filter:blur(12px);border-radius:20px;border:1px solid rgba(255,255,255,0.07);">
            <form asp-action="CambiarPassword" asp-route-id="@userId" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert" style="background:rgba(239,68,68,0.15);color:#fca5a5;border-radius:10px;border:none;"></div>

                <div class="mb-4">
                    <label class="text-secondary small mb-1">Nueva Contraseña *</label>
                    <input asp-for="NuevaContrasena" type="password" class="form-control"
                           style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;"
                           placeholder="Mínimo 6 caracteres" required minlength="6" />
                    <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                </div>

                <div class="alert mb-4" style="background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.2);border-radius:10px;color:#fcd34d;font-size:0.85rem;">
                    <i class="bi bi-info-circle me-2"></i>
                    La contraseña se almacenará con hash seguro PBKDF2+SHA256.
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn px-4" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:10px;">
                        Cancelar
                    </a>
                    <button type="submit" class="btn px-4 fw-semibold"
                            style="background:linear-gradient(135deg,#d97706,#f59e0b);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(217,119,6,0.3);">
                        <i class="bi bi-lock me-1"></i> Cambiar Contraseña
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
