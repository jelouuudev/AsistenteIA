@model IEnumerable<Asistente.Shared.UsuarioDto>
@{
    ViewData["Title"] = "Administración de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-people me-2" style="color:#818cf8;"></i>Usuarios</h4>
        <p class="text-secondary small mb-0">Gestión de usuarios del sistema</p>
    </div>
    <a asp-action="Crear" class="btn btn-sm px-4 py-2 fw-semibold"
       style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Usuario
    </a>
</div>

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Usuario</th>
                        <th class="text-secondary fw-normal py-3">Nombre</th>
                        <th class="text-secondary fw-normal py-3">Correo</th>
                        <th class="text-secondary fw-normal py-3">Roles</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                        <th class="text-secondary fw-normal py-3">Último acceso</th>
                        <th class="text-secondary fw-normal py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                                         style="width:36px;height:36px;background:linear-gradient(135deg,#6366f1,#a855f7);font-weight:bold;font-size:0.9rem;">
                                        @u.UsuarioNombre[0].ToString().ToUpper()
                                    </div>
                                    <span class="fw-semibold text-white">@u.UsuarioNombre</span>
                                </div>
                            </td>
                            <td class="text-secondary">@u.Nombres @u.Apellidos</td>
                            <td class="text-secondary small">@u.Correo</td>
                            <td>
                                @foreach (var rol in u.Roles)
                                {
                                    <span class="badge me-1" style="background:rgba(129,140,248,0.2);color:#a5b4fc;border:1px solid rgba(129,140,248,0.3);border-radius:20px;font-size:0.72rem;padding:3px 10px;">
                                        @rol
                                    </span>
                                }
                            </td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.25);border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-secondary small">
                                @(u.FechaUltimoAcceso.HasValue
                                    ? u.FechaUltimoAcceso.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    : "Sin acceso")
                            </td>
                            <td class="text-end px-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Editar" asp-route-id="@u.IdUsuario"
                                       class="btn btn-sm" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.2);border-radius:8px;" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="CambiarPassword" asp-route-id="@u.IdUsuario"
                                       class="btn btn-sm" style="background:rgba(251,191,36,0.15);color:#fcd34d;border:1px solid rgba(251,191,36,0.2);border-radius:8px;" title="Cambiar contraseña">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @if (u.Activo)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@u.IdUsuario" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Desactivar al usuario @u.UsuarioNombre?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm"
                                                    style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;" title="Desactivar">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">
                                <i class="bi bi-people fs-1 d-block mb-2 opacity-25"></i>
                                No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
