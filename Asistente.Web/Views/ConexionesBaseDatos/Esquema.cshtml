@model Asistente.Shared.EsquemaBaseDatosDto
@{
    ViewData["Title"] = "Esquema de Base de Datos";
    var tablasAutorizadas = (IEnumerable<Asistente.Shared.TablaAutorizadaDto>)ViewBag.TablasAutorizadas;
    var vistasAutorizadas = (IEnumerable<Asistente.Shared.VistaAutorizadaDto>)ViewBag.VistasAutorizadas;
    var autorizadasSet = new HashSet<string>(tablasAutorizadas.Select(t => t.NombreTabla.ToLowerInvariant()));
    var vistasSet = new HashSet<string>(vistasAutorizadas.Select(v => v.NombreVista.ToLowerInvariant()));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-diagram-3 me-2" style="color:#818cf8;"></i>Esquema: @ViewBag.ConexionNombre</h4>
        <p class="text-secondary small mb-0">Base de datos: <strong class="text-white">@Model.BaseDatos</strong> — Autorice tablas y vistas para consultas</p>
    </div>
    <a asp-action="Index" class="btn btn-sm px-4 py-2 fw-semibold"
       style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:#cbd5e1;border-radius:10px;">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 mb-4" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-header bg-transparent border-0 pt-3 px-4">
                <h6 class="text-white fw-semibold mb-0"><i class="bi bi-table me-2" style="color:#818cf8;"></i>Tablas (@Model.Tablas.Count)</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                        <thead style="background:rgba(0,0,0,0.2);">
                            <tr>
                                <th class="text-secondary fw-normal py-2 px-4">Tabla</th>
                                <th class="text-secondary fw-normal py-2">Columnas</th>
                                <th class="text-secondary fw-normal py-2 text-end px-4">Autorizar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Tablas)
                            {
                                var esAutorizada = autorizadasSet.Contains(t.Nombre.ToLowerInvariant());
                                <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                                    <td class="px-4 py-2">
                                        <span class="fw-semibold text-white">@t.Nombre</span>
                                        <div class="text-secondary" style="font-size:0.75rem;">@t.Esquema</div>
                                    </td>
                                    <td class="text-secondary small">@t.Columnas.Count</td>
                                    <td class="text-end px-4">
                                        @if (esAutorizada)
                                        {
                                            <form asp-action="QuitarTabla" asp-route-idConexion="@ViewBag.ConexionId" asp-route-idTabla="@tablasAutorizadas.First(x => x.NombreTabla.Equals(t.Nombre, StringComparison.OrdinalIgnoreCase)).IdTabla" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:8px;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Autorizada
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="AgregarTabla" asp-route-idConexion="@ViewBag.ConexionId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="nombreTabla" value="@t.Nombre" />
                                                <input type="hidden" name="esquema" value="@t.Esquema" />
                                                <input type="hidden" name="descripcion" value="" />
                                                <button type="submit" class="btn btn-sm" style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                                    <i class="bi bi-plus-circle me-1"></i>Autorizar
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Tablas.Any())
                            {
                                <tr><td colspan="3" class="text-center text-secondary py-4">No se encontraron tablas.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 mb-4" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-header bg-transparent border-0 pt-3 px-4">
                <h6 class="text-white fw-semibold mb-0"><i class="bi bi-eye me-2" style="color:#c084fc;"></i>Vistas (@Model.Vistas.Count)</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                        <thead style="background:rgba(0,0,0,0.2);">
                            <tr>
                                <th class="text-secondary fw-normal py-2 px-4">Vista</th>
                                <th class="text-secondary fw-normal py-2 text-end px-4">Autorizar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Vistas)
                            {
                                var esAutorizada = vistasSet.Contains(v.Nombre.ToLowerInvariant());
                                <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                                    <td class="px-4 py-2">
                                        <span class="fw-semibold text-white">@v.Nombre</span>
                                        <div class="text-secondary" style="font-size:0.75rem;">@v.Esquema</div>
                                    </td>
                                    <td class="text-end px-4">
                                        @if (esAutorizada)
                                        {
                                            <form asp-action="QuitarVista" asp-route-idConexion="@ViewBag.ConexionId" asp-route-idVista="@vistasAutorizadas.First(x => x.NombreVista.Equals(v.Nombre, StringComparison.OrdinalIgnoreCase)).IdVista" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:8px;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Autorizada
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="AgregarVista" asp-route-idConexion="@ViewBag.ConexionId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="nombreVista" value="@v.Nombre" />
                                                <input type="hidden" name="descripcion" value="" />
                                                <button type="submit" class="btn btn-sm" style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                                    <i class="bi bi-plus-circle me-1"></i>Autorizar
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Vistas.Any())
                            {
                                <tr><td colspan="2" class="text-center text-secondary py-4">No se encontraron vistas.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
