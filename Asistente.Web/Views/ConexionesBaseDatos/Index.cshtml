@model IEnumerable<Asistente.Shared.ConexionBaseDatosDto>
@{
    ViewData["Title"] = "Conexiones a Bases de Datos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-database me-2" style="color:#818cf8;"></i>Conexiones a Bases de Datos</h4>
        <p class="text-secondary small mb-0">Conexiones empresariales del motor de consultas</p>
    </div>
    <a asp-action="Crear" class="btn btn-sm px-4 py-2 fw-semibold"
       style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
        <i class="bi bi-plus-lg me-1"></i> Nueva Conexión
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Nombre</th>
                        <th class="text-secondary fw-normal py-3">Servidor</th>
                        <th class="text-secondary fw-normal py-3">Base de Datos</th>
                        <th class="text-secondary fw-normal py-3 text-center">Tablas</th>
                        <th class="text-secondary fw-normal py-3 text-center">Vistas</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                        <th class="text-secondary fw-normal py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                                         style="width:36px;height:36px;background:linear-gradient(135deg,#6366f1,#a855f7);font-weight:bold;font-size:0.9rem;">
                                        <i class="bi bi-database"></i>
                                    </div>
                                    <span class="fw-semibold text-white">@c.Nombre</span>
                                </div>
                            </td>
                            <td class="text-secondary small">@c.Servidor</td>
                            <td class="text-secondary small">@c.BaseDatos</td>
                            <td class="text-center"><span class="badge" style="background:rgba(129,140,248,0.2);color:#a5b4fc;border:1px solid rgba(129,140,248,0.3);border-radius:20px;">@c.TotalTablasAutorizadas</span></td>
                            <td class="text-center"><span class="badge" style="background:rgba(168,85,247,0.2);color:#c084fc;border:1px solid rgba(168,85,247,0.3);border-radius:20px;">@c.TotalVistasAutorizadas</span></td>
                            <td>
                                @if (c.Activa)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.25);border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Inactiva
                                    </span>
                                }
                            </td>
                            <td class="text-end px-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Esquema" asp-route-id="@c.IdConexion"
                                       class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2);border-radius:8px;" title="Esquema y autorización">
                                        <i class="bi bi-diagram-3"></i>
                                    </a>
                                    @if (c.Activa)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@c.IdConexion" method="post" class="d-inline"
                                              onsubmit="return confirm('Desactivar la conexión @c.Nombre?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm"
                                                    style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;" title="Desactivar">
                                                <i class="bi bi-toggle-off"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@c.IdConexion" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm"
                                                    style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2);border-radius:8px;" title="Activar">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Eliminar" asp-route-id="@c.IdConexion" method="post" class="d-inline"
                                          onsubmit="return confirm('Eliminar la conexión @c.Nombre? Se eliminarán sus tablas y vistas autorizadas.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm"
                                                style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">
                                <i class="bi bi-database fs-1 d-block mb-2 opacity-25"></i>
                                No hay conexiones registradas. <a asp-action="Crear" class="text-decoration-none" style="color:#818cf8;">Registre la primera.</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
