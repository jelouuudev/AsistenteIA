@model Asistente.Shared.CrearPromptRequest
@{
    ViewData["Title"] = "Crear Prompt";
    var asistentes = ViewBag.Asistentes as IEnumerable<Asistente.Shared.AsistenteDto> ?? new List<Asistente.Shared.AsistenteDto>();
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm me-3" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-file-plus me-2" style="color:#818cf8;"></i>Nuevo Prompt</h4>
        <p class="text-secondary small mb-0">Cree un nuevo prompt del sistema para un asistente</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 p-4" style="background:rgba(30,41,59,0.7);backdrop-filter:blur(12px);border-radius:20px;border:1px solid rgba(255,255,255,0.07);">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert" style="background:rgba(239,68,68,0.15);color:#fca5a5;border-radius:10px;border:none;"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="text-secondary small mb-1">Asistente *</label>
                        <select asp-for="IdAsistente" class="form-select" style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;">
                            @foreach (var a in asistentes)
                            {
                                <option value="@a.IdAsistente" selected="@(Model.IdAsistente == a.IdAsistente)">@a.Nombre (@a.ModeloIA)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary small mb-1">Nombre del Prompt *</label>
                        <input asp-for="Nombre" class="form-control" style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;" placeholder="Ej: Prompt principal" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="text-secondary small mb-1">Contenido del Prompt *</label>
                        <textarea asp-for="Contenido" class="form-control font-monospace" rows="12"
                                  style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;font-size:0.85rem;"
                                  placeholder="Escriba las instrucciones del sistema para el asistente..."></textarea>
                        <span asp-validation-for="Contenido" class="text-danger small"></span>
                        <div class="text-secondary small mt-2">
                            <i class="bi bi-info-circle"></i> Defina el comportamiento, reglas y conocimientos del asistente.
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn px-4" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:10px;">
                        Cancelar
                    </a>
                    <button type="submit" class="btn px-4 fw-semibold"
                            style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
                        <i class="bi bi-check-lg me-1"></i> Crear Prompt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
