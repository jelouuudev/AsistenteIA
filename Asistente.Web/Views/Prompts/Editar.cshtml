@model Asistente.Shared.ActualizarPromptRequest
@{
    ViewData["Title"] = "Editar Prompt";
    var promptId = (int)(ViewBag.PromptId ?? 0);
    var promptNombre = (string)(ViewBag.PromptNombre ?? "");
    var version = (int)(ViewBag.Version ?? 0);
    var idAsistente = (int)(ViewBag.IdAsistente ?? 0);
}

<div class="d-flex align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-pencil-square me-2" style="color:#818cf8;"></i>Editar Prompt</h4>
        <p class="text-secondary small mb-0">
            @promptNombre — Versión actual: <span class="badge" style="background:rgba(99,102,241,0.2);color:#818cf8;border:1px solid rgba(99,102,241,0.3);border-radius:20px;">v@(version)</span>
            — Se generará una nueva versión automáticamente
        </p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 p-4" style="background:rgba(30,41,59,0.7);backdrop-filter:blur(12px);border-radius:20px;border:1px solid rgba(255,255,255,0.07);">
            <form asp-action="Editar" asp-route-id="@promptId" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert" style="background:rgba(239,68,68,0.15);color:#fca5a5;border-radius:10px;border:none;"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="text-secondary small mb-1">Nombre del Prompt *</label>
                        <input asp-for="Nombre" class="form-control" style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary small mb-1">Motivo del cambio</label>
                        <input asp-for="MotivoCambio" class="form-control" style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;" placeholder="Ej: Se agregaron restricciones" />
                    </div>
                    <div class="col-12">
                        <label class="text-secondary small mb-1">Contenido del Prompt *</label>
                        <textarea asp-for="Contenido" class="form-control font-monospace" rows="14"
                                  style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;font-size:0.85rem;"></textarea>
                        <span asp-validation-for="Contenido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn px-4" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:10px;">
                        Cancelar
                    </a>
                    <button type="submit" class="btn px-4 fw-semibold"
                            style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
                        <i class="bi bi-save me-1"></i> Guardar y versionar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
