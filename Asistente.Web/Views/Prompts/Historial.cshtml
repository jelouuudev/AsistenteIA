@model IEnumerable<Asistente.Shared.HistorialPromptDto>
@{
    ViewData["Title"] = "Historial del Prompt";
    var promptNombre = (string)(ViewBag.PromptNombre ?? "");
    var versionActual = (int)(ViewBag.VersionActual ?? 0);
    var idAsistente = (int)(ViewBag.IdAsistente ?? 0);
    var id = (int)(ViewBag.PromptId ?? 0);
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" asp-route-asistenteId="@idAsistente" class="btn btn-sm me-3" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
        <i class="bi bi-arrow-left me-1"></i> Regresar
    </a>
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-clock-history me-2" style="color:#818cf8;"></i>Historial: @promptNombre</h4>
        <p class="text-secondary small mb-0">Versión actual: <span class="badge" style="background:rgba(99,102,241,0.2);color:#818cf8;border:1px solid rgba(99,102,241,0.3);border-radius:20px;">v@(versionActual)</span></p>
    </div>
</div>

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Versión</th>
                        <th class="text-secondary fw-normal py-3">Fecha</th>
                        <th class="text-secondary fw-normal py-3">Usuario</th>
                        <th class="text-secondary fw-normal py-3">Motivo</th>
                        <th class="text-secondary fw-normal py-3">Contenido</th>
                        <th class="text-secondary fw-normal py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <span class="badge" style="background:rgba(99,102,241,0.2);color:#818cf8;border:1px solid rgba(99,102,241,0.3);border-radius:20px;font-size:0.8rem;padding:4px 12px;">
                                    v@(h.Version) @(h.Version == versionActual ? "(actual)" : "")
                                </span>
                            </td>
                            <td class="text-secondary small">@h.FechaModificacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="text-white small">@h.UsuarioModificacion</td>
                            <td class="text-secondary small" style="max-width:200px;">@(h.MotivoCambio ?? "—")</td>
                            <td style="max-width:400px;">
                                <pre class="mb-0 text-secondary small" style="white-space:pre-wrap;max-height:80px;overflow-y:auto;background:rgba(15,23,42,0.4);border-radius:8px;padding:8px;font-size:0.75rem;line-height:1.3;">@h.Contenido</pre>
                            </td>
                            <td class="text-end px-4">
                                @if (h.Version != versionActual)
                                {
                                    <form asp-action="Restaurar" asp-route-id="@id" asp-route-idHistorial="@h.IdHistorial" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Restaurar versión v@(h.Version)? El prompt volverá a este estado.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2);border-radius:8px;" title="Restaurar">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-secondary small"><i class="bi bi-check2"></i></span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-secondary py-5">
                                <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-25"></i>
                                No hay historial registrado para este prompt.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
