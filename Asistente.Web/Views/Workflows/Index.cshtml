@model IEnumerable<Asistente.Shared.WorkflowDto>
@using Asistente.Shared
@{
    ViewData["Title"] = "Flujos de Trabajo";
    var lista = Model.ToList();
    var reglasPorWorkflow = ViewBag.ReglasPorWorkflow as Dictionary<int, List<ReglaEventoDto>> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-diagram-3 me-2" style="color:#818cf8;"></i>Motor de Flujos de Trabajo</h4>
        <p class="text-secondary small mb-0">Defina y administre procesos empresariales automatizados (Workflow Engine)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Configuracion" class="btn btn-outline-light btn-sm"><i class="bi bi-sliders me-1"></i>Configuración</a>
        <a asp-action="Crear" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nuevo Flujo</a>
    </div>
</div>

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Nombre</th>
                        <th class="text-secondary fw-normal py-3">Código</th>
                        <th class="text-secondary fw-normal py-3 text-center">Versión</th>
                        <th class="text-secondary fw-normal py-3 text-center">Pasos</th>
                        <th class="text-secondary fw-normal py-3">Invocado por</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                        <th class="text-secondary fw-normal py-3 text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in lista)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <div class="text-white fw-semibold">@w.Nombre</div>
                                @if (!string.IsNullOrEmpty(w.Descripcion))
                                {
                                    <div class="text-secondary small" style="max-width:320px;">@w.Descripcion</div>
                                }
                                @if (!string.IsNullOrEmpty(w.Disparadores))
                                {
                                    <div class="text-secondary small mt-1"><i class="bi bi-lightning-charge me-1"></i>Disparador: <span class="font-monospace">@w.Disparadores</span></div>
                                }
                            </td>
                            <td><span class="font-monospace text-white small">@w.Codigo</span></td>
                            <td class="text-center text-secondary">v@(w.Version)</td>
                            <td class="text-center text-secondary">@w.CantidadPasos</td>
                            <td class="small" style="max-width:260px;">
                                @if (reglasPorWorkflow.TryGetValue(w.IdWorkflow, out var reglas) && reglas.Any())
                                {
                                    @foreach (var r in reglas)
                                    {
                                        <div class="mb-1">
                                            <i class="bi bi-lightning-charge me-1" style="color:#818cf8;"></i><span class="text-white">@r.NombreEvento</span>
                                            @if (!r.Activa)
                                            {
                                                <span class="badge ms-1" style="background:rgba(148,163,184,0.15);color:#cbd5e1;border-radius:20px;">inactiva</span>
                                            }
                                            <div class="font-monospace text-secondary" style="font-size:0.75rem;">@(string.IsNullOrEmpty(r.Condicion) ? "(siempre)" : r.Condicion)</div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td>
                                @if (w.Estado == "Activo")
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:20px;">Activo</span>
                                }
                                else if (w.Estado == "Suspendido")
                                {
                                    <span class="badge" style="background:rgba(251,191,36,0.15);color:#fcd34d;border:1px solid rgba(251,191,36,0.25);border-radius:20px;">Suspendido</span>
                                }
                                else if (w.Estado == "Borrador")
                                {
                                    <span class="badge" style="background:rgba(148,163,184,0.15);color:#cbd5e1;border:1px solid rgba(148,163,184,0.25);border-radius:20px;">Borrador</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.25);border-radius:20px;">@w.Estado</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                    <a asp-action="Editar" asp-route-id="@w.IdWorkflow" class="btn btn-outline-light btn-sm py-1 px-2"><i class="bi bi-pencil"></i></a>
                                    @if (w.Estado == "Activo")
                                    {
                                        <form asp-action="Desactivar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@w.IdWorkflow" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm py-1 px-2" title="Suspender"><i class="bi bi-pause-fill"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@w.IdWorkflow" />
                                            <button type="submit" class="btn btn-outline-success btn-sm py-1 px-2" title="Activar"><i class="bi bi-play-fill"></i></button>
                                        </form>
                                    }
                                    <form asp-action="Versionar" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@w.IdWorkflow" />
                                        <button type="submit" class="btn btn-outline-info btn-sm py-1 px-2" title="Nueva versión"><i class="bi bi-git"></i></button>
                                    </form>
                                    <form asp-action="Eliminar" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar el flujo @w.Nombre?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@w.IdWorkflow" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!lista.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">
                                <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
                                Aún no hay flujos de trabajo. Haga clic en <strong>Nuevo Flujo</strong> para crear uno.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="MonitoreoWorkflows" asp-action="Index" class="btn btn-outline-light btn-sm"><i class="bi bi-speedometer2 me-1"></i>Ver monitoreo de ejecuciones</a>
</div>
