@model Asistente.Shared.ActualizarWorkflowRequest
@{
    ViewData["Title"] = "Editar Flujo de Trabajo";
    int wfId = (int)ViewBag.IdWorkflow;
}
<style>
    select.form-control option { background-color: #0f172a; color: #f1f5f9; }
</style>

<div class="mb-4">
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-pencil me-2" style="color:#818cf8;"></i>Editar Flujo de Trabajo</h4>
    <p class="text-secondary small mb-0">Modifique los pasos y la configuración del flujo</p>
</div>

<form asp-action="Editar" asp-route-id="@wfId" method="post" id="formWorkflow">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3" style="background:rgba(239,68,68,0.15);color:#fca5a5;border-radius:12px;"></div>
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card border-0 mb-3" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                <div class="card-body">
                    <h6 class="text-white fw-semibold mb-3"><i class="bi bi-info-circle me-2;"></i>Datos del flujo</h6>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Nombre</label>
                        <input asp-for="Nombre" class="form-control bg-transparent text-white border-secondary" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Código (único)</label>
                        <input asp-for="Codigo" class="form-control bg-transparent text-white border-secondary font-monospace" />
                        <span asp-validation-for="Codigo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control bg-transparent text-white border-secondary" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Frases disparadoras (separadas por ;)</label>
                        <input asp-for="Disparadores" class="form-control bg-transparent text-white border-secondary" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-white fw-semibold mb-0"><i class="bi bi-list-ol me-2;"></i>Pasos del flujo</h6>
                        <button type="button" class="btn btn-outline-light btn-sm" onclick="agregarPaso()"><i class="bi bi-plus-lg me-1;"></i>Paso</button>
                    </div>
                    <div id="pasosContainer">
                        @for (int i = 0; i < Model.Pasos.Count; i++)
                        {
                            <div class="paso-card border rounded p-3 mb-2" style="border-color:rgba(255,255,255,0.1);background:rgba(15,23,42,0.4);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary">Paso @(i + 1)</span>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0" onclick="this.closest('.paso-card').remove();reindex();"><i class="bi bi-x"></i></button>
                                </div>
                                <input type="hidden" name="Pasos[@i].Orden" value="@Model.Pasos[i].Orden" class="input-orden" />
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label text-secondary small">Nombre</label>
                                        <input name="Pasos[@i].Nombre" value="@Model.Pasos[i].Nombre" class="form-control bg-transparent text-white border-secondary form-control-sm" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label text-secondary small">Herramienta</label>
                                        <select name="Pasos[@i].Herramienta" class="form-control bg-transparent text-white border-secondary form-control-sm">
                                            @foreach (var (codigo, desc) in new[] { ("SqlQueryTool", "Consulta SQL"), ("DocumentSearchTool", "Búsqueda documental RAG"), ("ReportTool", "Reporte PDF"), ("CalculatorTool", "Cálculos"), ("DateTimeTool", "Fecha y hora") })
                                            {
                                                <option value="@codigo" title="@desc" selected="@(Model.Pasos[i].Herramienta == codigo)">@codigo — @desc</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <label class="form-label text-secondary small">Parámetros (JSON)</label>
                                    <textarea name="Pasos[@i].Parametros" class="form-control bg-transparent text-white border-secondary form-control-sm font-monospace" rows="2">@Model.Pasos[i].Parametros</textarea>
                                    <div class="form-text text-secondary">Use <code>{{resultado}}</code> para el resultado del paso anterior.</div>
                                </div>
                                <div class="row g-2 mt-1">
                                    <div class="col-4">
                                        <label class="form-label text-secondary small">Reintentos</label>
                                        <input name="Pasos[@i].ReintentosMaximos" value="@Model.Pasos[i].ReintentosMaximos" type="number" min="0" max="10" class="form-control bg-transparent text-white border-secondary form-control-sm" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label text-secondary small">T. máx. (ms)</label>
                                        <input name="Pasos[@i].TiempoMaximoMs" value="@Model.Pasos[i].TiempoMaximoMs" type="number" min="1" step="1" class="form-control bg-transparent text-white border-secondary form-control-sm" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label text-secondary small">Estrategia error</label>
                                        <select name="Pasos[@i].EstrategiaError" class="form-control bg-transparent text-white border-secondary form-control-sm">
                                            @foreach (var e in new[] { "Cancelar", "Omitir" })
                                            {
                                                <option value="@e" selected="@(Model.Pasos[i].EstrategiaError == e)">@e</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" name="Pasos[@i].RequiereConfirmacion" value="true" id="conf@(i)" checked="@Model.Pasos[i].RequiereConfirmacion" />
                                    <label class="form-check-label text-secondary small" for="conf@(i)">Requiere confirmación del usuario</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1;"></i>Guardar cambios</button>
        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
    </div>
</form>

@section Scripts {
<script>
    function reindex() {
        document.querySelectorAll('#pasosContainer .paso-card').forEach((card, idx) => {
            // Actualizar badge
            card.querySelector('.badge').textContent = 'Paso ' + (idx + 1);
            
            // Actualizar todos los inputs y selects dentro de esta tarjeta
            card.querySelectorAll('input, select, textarea').forEach(el => {
                // Si ya tiene name con patrón Pasos[X].Campo, actualizar el índice
                if (el.name && el.name.match(/^Pasos\[\d+\]\./)) {
                    el.name = el.name.replace(/^Pasos\[\d+\]\./, 'Pasos[' + idx + '].');
                }
                // Actualizar IDs de checkbox
                if (el.id && el.id.startsWith('conf')) {
                    el.id = 'conf' + idx;
                }
            });
            
            // Actualizar for de labels que apuntan a checkboxes
            card.querySelectorAll('label[for^="conf"]').forEach(label => {
                label.setAttribute('for', 'conf' + idx);
            });
        });
    }
    
    function agregarPaso() {
        const cont = document.getElementById('pasosContainer');
        const idx = cont.querySelectorAll('.paso-card').length;
        const html = `<div class="paso-card border rounded p-3 mb-2" style="border-color:rgba(255,255,255,0.1);background:rgba(15,23,42,0.4);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-secondary">Paso ${idx + 1}</span>
                <button type="button" class="btn btn-sm btn-outline-danger py-0" onclick="this.closest('.paso-card').remove();reindex();"><i class="bi bi-x"></i></button>
            </div>
            <input type="hidden" name="Pasos[${idx}].Orden" value="${idx + 1}" />
            <div class="row g-2">
                <div class="col-6"><label class="form-label text-secondary small">Nombre</label><input name="Pasos[${idx}].Nombre" class="form-control bg-transparent text-white border-secondary form-control-sm" /></div>
                <div class="col-12"><label class="form-label text-secondary small">Herramienta</label>
                    <select name="Pasos[${idx}].Herramienta" class="form-control bg-transparent text-white border-secondary form-control-sm">
                        <option value="SqlQueryTool" title="Consulta SQL">SqlQueryTool — Consulta SQL</option><option value="DocumentSearchTool" title="Búsqueda documental RAG">DocumentSearchTool — Búsqueda documental RAG</option><option value="ReportTool" title="Reporte PDF">ReportTool — Reporte PDF</option><option value="CalculatorTool" title="Cálculos">CalculatorTool — Cálculos</option><option value="DateTimeTool" title="Fecha y hora">DateTimeTool — Fecha y hora</option>
                    </select></div>
            </div>
            <div class="mt-2"><label class="form-label text-secondary small">Parámetros (JSON)</label>
                <textarea name="Pasos[${idx}].Parametros" class="form-control bg-transparent text-white border-secondary form-control-sm font-monospace" rows="2">{}</textarea>
                <div class="form-text text-secondary">Use {{resultado}} para el resultado del paso anterior.</div></div>
            <div class="row g-2 mt-1">
                <div class="col-4"><label class="form-label text-secondary small">Reintentos</label><input name="Pasos[${idx}].ReintentosMaximos" value="1" type="number" min="0" max="10" class="form-control bg-transparent text-white border-secondary form-control-sm" /></div>
                <div class="col-4"><label class="form-label text-secondary small">T. máx. (ms)</label><input name="Pasos[${idx}].TiempoMaximoMs" value="60000" type="number" min="1" step="1" class="form-control bg-transparent text-white border-secondary form-control-sm" /></div>
                <div class="col-4"><label class="form-label text-secondary small">Estrategia error</label>
                    <select name="Pasos[${idx}].EstrategiaError" class="form-control bg-transparent text-white border-secondary form-control-sm">
                        <option>Cancelar</option><option>Omitir</option></select></div>
            </div>
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="Pasos[${idx}].RequiereConfirmacion" value="true" id="conf${idx}" />
                <label class="form-check-label text-secondary small" for="conf${idx}">Requiere confirmación del usuario</label>
            </div>
        </div>`;
        cont.insertAdjacentHTML('beforeend', html);
    }
    
    // Inicializar nombres al cargar
    reindex();
</script>
}