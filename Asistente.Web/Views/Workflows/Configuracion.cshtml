@model Asistente.Shared.ConfiguracionWorkflowDto
@{
    ViewData["Title"] = "Configuración del Motor de Flujos";
}

<div class="mb-4">
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-sliders me-2" style="color:#818cf8;"></i>Configuración del Motor de Flujos</h4>
    <p class="text-secondary small mb-0">Parámetros globales del Workflow Engine (Actividad 10 del RF)</p>
</div>

<form asp-action="Configuracion" method="post">
    @Html.AntiForgeryToken()
    <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);max-width:680px;">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label text-secondary small">Reintentos máximos (por paso)</label>
                    <input asp-for="ReintentosMaximos" type="number" min="0" max="10" class="form-control bg-transparent text-white border-secondary" />
                    <span asp-validation-for="ReintentosMaximos" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label text-secondary small">Límite de pasos por workflow</label>
                    <input asp-for="LimitePasosPorWorkflow" type="number" min="1" max="50" class="form-control bg-transparent text-white border-secondary" />
                    <span asp-validation-for="LimitePasosPorWorkflow" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label text-secondary small">Tiempo máximo por paso (ms)</label>
                    <input asp-for="TiempoMaximoPasoMs" type="number" min="1000" step="1000" class="form-control bg-transparent text-white border-secondary" />
                    <span asp-validation-for="TiempoMaximoPasoMs" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label class="form-label text-secondary small">Tiempo máximo del flujo (ms)</label>
                    <input asp-for="TiempoMaximoFlujoMs" type="number" min="5000" step="1000" class="form-control bg-transparent text-white border-secondary" />
                    <span asp-validation-for="TiempoMaximoFlujoMs" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" asp-for="ConfirmacionesObligatorias" id="conf" />
                <label class="form-check-label text-secondary" for="conf">Confirmaciones obligatorias en pasos sensibles</label>
            </div>
            <div class="form-text text-secondary">Cuando está activo, un paso marcado como sensible pedirá confirmación del usuario antes de ejecutarse.</div>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar configuración</button>
        <a asp-action="Index" class="btn btn-outline-light">Volver</a>
    </div>
</form>
