@model IEnumerable<Asistente.Shared.AuditoriaDocumentalDto>
@{
    ViewData["Title"] = "Auditoría Documental Completa";
}

<div class="mb-4">
    <a asp-action="Index" class="text-secondary small text-decoration-none d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-chevron-left"></i> Volver a Documentos
    </a>
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-journal-text me-2" style="color:#818cf8;"></i>Registro de Auditoría Documental</h4>
    <p class="text-secondary small mb-0">Auditoría global de acciones sobre el repositorio de documentos y conocimientos del sistema</p>
</div>

<div class="card border-0 shadow-lg" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid rgba(255,255,255,0.07);color:#94a3b8;font-size:0.85rem;">
                        <th class="py-3 px-4" style="background:transparent;">Fecha</th>
                        <th class="py-3" style="background:transparent;">Documento</th>
                        <th class="py-3 text-center" style="background:transparent;">Versión</th>
                        <th class="py-3 text-center" style="background:transparent;">Acción</th>
                        <th class="py-3" style="background:transparent;">Descripción</th>
                        <th class="py-3 text-center" style="background:transparent;">Usuario ID</th>
                        <th class="py-3 text-end px-4" style="background:transparent;">Dirección IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aud in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);transition:background-color 0.2s;">
                            <td class="py-3 px-4 text-secondary small" style="background:transparent;">@aud.FechaAccion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3" style="background:transparent;">
                                <div class="fw-bold text-white">@aud.DocumentoNombre</div>
                                <span class="text-secondary small">Doc ID: @aud.IdDocumento</span>
                            </td>
                            <td class="py-3 text-center font-monospace text-white-50" style="background:transparent;">
                                @(aud.IdVersion.HasValue ? $"v{aud.IdVersion.Value}" : "—")
                            </td>
                            <td class="py-3 text-center" style="background:transparent;">
                                <span class="badge text-uppercase" style="background:rgba(99,102,241,0.12);color:#a5b4fc;font-size:0.65rem;border:1px solid rgba(99,102,241,0.2);border-radius:6px;padding:4px 8px;">
                                    @aud.Accion
                                </span>
                            </td>
                            <td class="py-3 text-light small" style="background:transparent;">@aud.Descripcion</td>
                            <td class="py-3 text-center font-monospace text-secondary" style="background:transparent;">@aud.UsuarioId</td>
                            <td class="py-3 text-end px-4 font-monospace text-secondary" style="background:transparent;">@(aud.DireccionIP ?? "127.0.0.1")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 opacity-25"></i>
                                No hay actividades de auditoría documental registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
