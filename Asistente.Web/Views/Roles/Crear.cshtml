@model Asistente.Shared.CrearRolRequest
@{ ViewData["Title"] = "Crear Rol"; }

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm me-3" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-shield-plus me-2" style="color:#818cf8;"></i>Nuevo Rol</h4>
        <p class="text-secondary small mb-0">Define un nuevo perfil de acceso</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 p-4" style="background:rgba(30,41,59,0.7);backdrop-filter:blur(12px);border-radius:20px;border:1px solid rgba(255,255,255,0.07);">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert" style="background:rgba(239,68,68,0.15);color:#fca5a5;border-radius:10px;border:none;"></div>

                <div class="mb-3">
                    <label class="text-secondary small mb-1">Nombre del Rol *</label>
                    <input asp-for="Nombre" class="form-control" style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;" placeholder="Ej: Auditor" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label class="text-secondary small mb-1">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"
                              style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.1);color:#f1f5f9;border-radius:10px;resize:none;"
                              placeholder="Describe los permisos del rol..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn px-4" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:10px;">
                        Cancelar
                    </a>
                    <button type="submit" class="btn px-4 fw-semibold"
                            style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
                        <i class="bi bi-check-lg me-1"></i> Crear Rol
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
