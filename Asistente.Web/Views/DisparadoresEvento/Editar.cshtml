@model Asistente.Shared.DisparadorEventoDto
@{
    ViewData["Title"] = "Editar Disparador de Evento";
    var eventos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Eventos;
}

<div class="mb-4">
    <a asp-action="Index" class="text-secondary text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a disparadores</a>
</div>

<h4 class="text-white fw-bold mb-1"><i class="bi bi-pencil me-2" style="color:#818cf8;"></i>Editar Disparador de Evento</h4>
<p class="text-secondary small">Modifique la configuración del disparador.</p>

<div class="card border-0 mt-3" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);max-width:720px;">
    <div class="card-body p-4">
        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdDisparador" />
            <div class="mb-3">
                <label class="form-label text-white-50 small">Evento origen *</label>
                <select asp-for="IdEvento" class="form-select bg-dark text-light border-secondary" asp-items="@eventos"></select>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Tipo de disparador *</label>
                <select name="Tipo" class="form-select bg-dark text-light border-secondary">
                    <!option value="Cron" @(Model.Tipo == "Cron" ? "selected" : "")>Cron (por horario)</!option>
                    <!option value="SondeoBD" @(Model.Tipo == "SondeoBD" ? "selected" : "")>Sondeo BD (consulta SQL)</!option>
                    <!option value="Documento" @(Model.Tipo == "Documento" ? "selected" : "")>Documento</!option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Configuración JSON *</label>
                <textarea name="ConfigJson" class="form-control bg-dark text-light border-secondary font-monospace" rows="4">@Model.ConfigJson</textarea>
                <div class="form-text text-secondary">Formato según el tipo de disparador seleccionado.</div>
            </div>
            <div class="form-check form-switch mb-4">
                <input type="checkbox" name="Activo" value="true" class="form-check-input" role="switch" id="activoSwitch" @(Model.Activo ? "checked" : "") />
                <label class="form-check-label text-white-50 small" for="activoSwitch">Disparador activo</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>
