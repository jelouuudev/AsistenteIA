@model Asistente.Shared.CrearDisparadorEventoRequest
@{
    ViewData["Title"] = "Nuevo Disparador de Evento";
    var eventos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Eventos;
}

<div class="mb-4">
    <a asp-action="Index" class="text-secondary text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a disparadores</a>
</div>

<h4 class="text-white fw-bold mb-1"><i class="bi bi-lightning-charge-fill me-2" style="color:#818cf8;"></i>Configurar Disparador de Evento</h4>
<p class="text-secondary small">Defina cuándo y cómo se dispara automáticamente un evento sin intervención del usuario.</p>

<div class="card border-0 mt-3" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);max-width:720px;">
    <div class="card-body p-4">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label text-white-50 small">Evento origen *</label>
                <select asp-for="IdEvento" class="form-select bg-dark text-light border-secondary" asp-items="@eventos">
                    <option value="0">Seleccione un evento...</option>
                </select>
                <span asp-validation-for="IdEvento" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Tipo de disparador *</label>
                <select asp-for="Tipo" class="form-select bg-dark text-light border-secondary">
                    <option value="Cron">Cron (por horario)</option>
                    <option value="SondeoBD">Sondeo BD (consulta SQL periódica)</option>
                    <option value="Documento">Documento (al procesar un documento)</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Configuración JSON *</label>
                <textarea asp-for="ConfigJson" class="form-control bg-dark text-light border-secondary font-monospace" rows="4" placeholder='{"cron":"0 * * * * ?"}'></textarea>
                <div class="form-text text-secondary">
                    <strong>Cron:</strong> {"cron":"0 * * * * ?"} (cada hora)<br>
                    <strong>SondeoBD:</strong> {"idConexion":1,"consultaSql":"SELECT COUNT(*) FROM Tabla","intervaloSegundos":300,"modo":"SiHayFilas"}<br>
                    <strong>Documento:</strong> {"idCategoria":null,"codigoDocumento":null} (vacío = cualquier documento)
                </div>
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="Activo" class="form-check-input" role="switch" id="activoSwitch" />
                <label class="form-check-label text-white-50 small" for="activoSwitch">Disparador activo</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar Disparador</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>
