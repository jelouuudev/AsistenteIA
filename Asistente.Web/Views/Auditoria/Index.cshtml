@using Asistente.Shared
@{
    ViewData["Title"] = "Auditoría";
    var sesiones = ViewBag.Sesiones as IEnumerable<AuditoriaSesionDto> ?? new List<AuditoriaSesionDto>();
    var actividades = ViewBag.Actividades as IEnumerable<AuditoriaActividadDto> ?? new List<AuditoriaActividadDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-journal-text me-2" style="color:#818cf8;"></i>Auditoría</h4>
        <p class="text-secondary small mb-0">Registro de accesos y actividades del sistema</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge px-3 py-2" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.2);border-radius:8px;font-size:0.8rem;">
            <i class="bi bi-door-open me-1"></i> @sesiones.Count() sesiones
        </span>
        <span class="badge px-3 py-2" style="background:rgba(168,85,247,0.15);color:#c084fc;border:1px solid rgba(168,85,247,0.2);border-radius:8px;font-size:0.8rem;">
            <i class="bi bi-activity me-1"></i> @actividades.Count() actividades
        </span>
    </div>
</div>

<!-- Tabs -->
<ul class="nav mb-4 gap-2" id="auditTab" role="tablist">
    <li class="nav-item">
        <button class="btn btn-sm active" id="sesiones-tab" data-bs-toggle="tab" data-bs-target="#sesiones-pane"
                style="background:rgba(99,102,241,0.2);color:#818cf8;border:1px solid rgba(99,102,241,0.3);border-radius:8px;padding:6px 18px;">
            <i class="bi bi-door-open me-1"></i> Sesiones
        </button>
    </li>
    <li class="nav-item">
        <button class="btn btn-sm" id="actividades-tab" data-bs-toggle="tab" data-bs-target="#actividades-pane"
                style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:6px 18px;">
            <i class="bi bi-activity me-1"></i> Actividades
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- SESIONES -->
    <div class="tab-pane fade show active" id="sesiones-pane">
        <div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                    <thead style="background:rgba(0,0,0,0.2);">
                        <tr class="border-bottom border-secondary">
                            <th class="text-secondary fw-normal py-3 px-4 small">#</th>
                            <th class="text-secondary fw-normal py-3 small">Usuario</th>
                            <th class="text-secondary fw-normal py-3 small">Inicio</th>
                            <th class="text-secondary fw-normal py-3 small">Fin</th>
                            <th class="text-secondary fw-normal py-3 small">IP</th>
                            <th class="text-secondary fw-normal py-3 small">Navegador</th>
                            <th class="text-secondary fw-normal py-3 small">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in sesiones)
                        {
                            <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                                <td class="px-4 text-secondary small">@s.IdSesion</td>
                                <td class="fw-semibold text-white small">@s.UsuarioNombre</td>
                                <td class="text-secondary small">@s.FechaInicio.ToLocalTime().ToString("dd/MM/yy HH:mm:ss")</td>
                                <td class="text-secondary small">@(s.FechaFin.HasValue ? s.FechaFin.Value.ToLocalTime().ToString("dd/MM/yy HH:mm:ss") : "—")</td>
                                <td class="text-secondary small">@(s.DireccionIP ?? "—")</td>
                                <td class="text-secondary small" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@s.Navegador">
                                    @(s.Navegador?.Length > 40 ? s.Navegador[..40] + "…" : s.Navegador ?? "—")
                                </td>
                                <td>
                                    @{
                                        var (bg, color, icon) = s.Estado switch {
                                            "Exitoso" => ("rgba(16,185,129,0.2)", "#6ee7b7", "bi-check-circle"),
                                            "Fallido" => ("rgba(239,68,68,0.15)", "#fca5a5", "bi-x-circle"),
                                            "Cerrado" => ("rgba(100,116,139,0.2)", "#94a3b8", "bi-dash-circle"),
                                            "Inactivo" => ("rgba(251,191,36,0.15)", "#fcd34d", "bi-pause-circle"),
                                            _ => ("rgba(99,102,241,0.15)", "#818cf8", "bi-circle")
                                        };
                                    }
                                    <span class="badge" style="background:@bg;color:@color;border:1px solid @(color + "44");border-radius:20px;padding:3px 10px;font-size:0.72rem;">
                                        <i class="bi @icon me-1"></i>@s.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!sesiones.Any())
                        {
                            <tr><td colspan="7" class="text-center text-secondary py-5">Sin registros de sesiones.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ACTIVIDADES -->
    <div class="tab-pane fade" id="actividades-pane">
        <div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                    <thead style="background:rgba(0,0,0,0.2);">
                        <tr class="border-bottom border-secondary">
                            <th class="text-secondary fw-normal py-3 px-4 small">#</th>
                            <th class="text-secondary fw-normal py-3 small">Usuario</th>
                            <th class="text-secondary fw-normal py-3 small">Fecha</th>
                            <th class="text-secondary fw-normal py-3 small">Módulo</th>
                            <th class="text-secondary fw-normal py-3 small">Acción</th>
                            <th class="text-secondary fw-normal py-3 small">Descripción</th>
                            <th class="text-secondary fw-normal py-3 small">IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in actividades)
                        {
                            <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                                <td class="px-4 text-secondary small">@a.IdActividad</td>
                                <td class="fw-semibold text-white small">@a.UsuarioNombre</td>
                                <td class="text-secondary small">@a.FechaHora.ToLocalTime().ToString("dd/MM/yy HH:mm:ss")</td>
                                <td>
                                    <span class="badge" style="background:rgba(129,140,248,0.15);color:#a5b4fc;border:1px solid rgba(129,140,248,0.25);border-radius:20px;padding:3px 10px;font-size:0.72rem;">
                                        @a.Modulo
                                    </span>
                                </td>
                                <td class="text-secondary small">@a.Accion</td>
                                <td class="text-secondary small" style="max-width:250px;">@a.Descripcion</td>
                                <td class="text-secondary small">@(a.DireccionIP ?? "—")</td>
                            </tr>
                        }
                        @if (!actividades.Any())
                        {
                            <tr><td colspan="7" class="text-center text-secondary py-5">Sin registros de actividad.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Tab switching style update
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(btn => {
        btn.addEventListener('show.bs.tab', function() {
            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(b => {
                b.style.background = 'rgba(255,255,255,0.05)';
                b.style.color = '#94a3b8';
                b.style.borderColor = 'rgba(255,255,255,0.08)';
            });
            this.style.background = 'rgba(99,102,241,0.2)';
            this.style.color = '#818cf8';
            this.style.borderColor = 'rgba(99,102,241,0.3)';
        });
    });
</script>
}
