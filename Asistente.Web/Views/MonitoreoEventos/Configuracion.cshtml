@model Asistente.Shared.ConfiguracionEventoMotorDto
@{
    ViewData["Title"] = "Configuración del Motor de Eventos";
}

<div class="mb-4">
    <a asp-action="Index" class="text-secondary text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver al panel</a>
</div>

<h4 class="text-white fw-bold mb-1"><i class="bi bi-sliders me-2" style="color:#818cf8;"></i>Configuración del Motor de Eventos</h4>
<p class="text-secondary small">Políticas de reintento, concurrencia y frecuencia del procesador (Actividad 10).</p>

<div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);max-width:720px;">
    <div class="card-body p-4">
        <form asp-action="Configuracion" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label text-white-50 small">Reintentos máximos</label>
                <input asp-for="ReintentosMaximos" type="number" min="0" class="form-control bg-dark text-light border-secondary" style="max-width:140px;" />
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Intervalo entre reintentos (ms)</label>
                <input asp-for="IntervaloReintentoMs" type="number" min="100" class="form-control bg-dark text-light border-secondary" style="max-width:160px;" />
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Tiempo máximo por evento (ms)</label>
                <input asp-for="TiempoMaximoEventoMs" type="number" min="1000" class="form-control bg-dark text-light border-secondary" style="max-width:180px;" />
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Eventos simultáneos máximos</label>
                <input asp-for="EventosSimultaneosMax" type="number" min="1" class="form-control bg-dark text-light border-secondary" style="max-width:140px;" />
            </div>
            <div class="mb-4">
                <label class="form-label text-white-50 small">Frecuencia del procesador (ms)</label>
                <input asp-for="FrecuenciaProcesadorMs" type="number" min="500" class="form-control bg-dark text-light border-secondary" style="max-width:160px;" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar Configuración</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>
