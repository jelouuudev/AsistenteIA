@{
    ViewData["Title"] = "Mi bandeja de aprobaciones";
}
<div class="mb-4">
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-inbox me-2" style="color:#818cf8;"></i>Mi bandeja de aprobaciones</h4>
    <p class="text-secondary small mb-0">Solicitudes asignadas a usted que requieren una decisión (ETAPA 19, Actividad 12).</p>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (ViewBag.Error != null) { <div class="alert alert-warning">@ViewBag.Error</div> }

@{
    var bandeja = ViewBag.Bandeja;
}

<div class="row">
    <div class="col-12">
        <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-body p-4">
                @if (bandeja is not null && bandeja.ValueKind == System.Text.Json.JsonValueKind.Array && bandeja.GetArrayLength() > 0)
                {
                    foreach (var s in bandeja.EnumerateArray())
                    {
                        var id = s.GetProperty("idApproval").GetInt32();
                        <div class="border rounded p-3 mb-3" style="background:rgba(15,23,42,0.4);border-color:rgba(255,255,255,0.08)!important;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <span class="text-white fw-semibold">@s.GetProperty("codigo").GetString()</span>
                                    <span class="badge ms-2" style="background:rgba(250,204,21,0.2);color:#fde68a;">@s.GetProperty("tipo").GetString()</span>
                                </div>
                                <span class="text-secondary small">Plan #@s.GetProperty("idPlan").GetInt32()</span>
                            </div>
                            @if (s.TryGetProperty("observaciones", out System.Text.Json.JsonElement obs) && !string.IsNullOrEmpty(obs.GetString()))
                            {
                                <p class="text-secondary small mb-2">@obs.GetString()</p>
                            }
                            <form asp-action="Decidir" method="post" class="row g-2 align-items-end">
                                <input type="hidden" name="id" value="@id" />
                                <div class="col-md-8">
                                    <input type="text" name="comentario" class="form-control bg-dark text-white border-secondary" placeholder="Motivo / comentario (se conserva en auditoría)" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" name="decision" value="Aprobar" class="btn btn-sm w-100 fw-semibold" style="background:#16a34a;color:white;border:none;border-radius:8px;">Aprobar</button>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" name="decision" value="Rechazar" class="btn btn-sm w-100 fw-semibold" style="background:#dc2626;color:white;border:none;border-radius:8px;">Rechazar</button>
                                </div>
                            </form>
                            <form asp-action="Delegar" method="post" class="row g-2 align-items-end mt-1">
                                <input type="hidden" name="id" value="@id" />
                                <div class="col-md-8">
                                    <input type="number" name="idUsuarioDestino" min="1" required class="form-control bg-dark text-white border-secondary" placeholder="ID usuario destino" />
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-sm w-100 fw-semibold" style="background:linear-gradient(135deg,#6366f1,#a855f7);color:white;border:none;border-radius:8px;">Delegar</button>
                                </div>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary mb-0">No tienes solicitudes pendientes. <a asp-action="Index" class="text-info">Ver dashboard</a>.</p>
                }
            </div>
        </div>
    </div>
</div>
