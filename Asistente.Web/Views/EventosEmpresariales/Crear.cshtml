@model Asistente.Shared.CrearEventoEmpresarialRequest
@{
    ViewData["Title"] = "Nuevo Evento Empresarial";
}

<div class="mb-4">
    <a asp-action="Index" class="text-secondary text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a eventos</a>
</div>

<h4 class="text-white fw-bold mb-1"><i class="bi bi-lightning-charge-fill me-2" style="color:#818cf8;"></i>Registrar Evento Empresarial</h4>
<p class="text-secondary small">Defina un evento del sistema, de negocio o de seguridad que podrá disparar automatizaciones.</p>

<div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);max-width:720px;">
    <div class="card-body p-4">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label text-white-50 small">Código *</label>
                <input asp-for="Codigo" class="form-control bg-dark text-light border-secondary" placeholder="Ej: DOC_PROCESADO" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
                <div class="form-text text-secondary">Identificador único usado para disparar el evento (sin espacios).</div>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Nombre *</label>
                <input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Documento Procesado" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control bg-dark text-light border-secondary" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Categoría</label>
                <select asp-for="Categoria" class="form-select bg-dark text-light border-secondary">
                    <option value="Sistema">Sistema</option>
                    <option value="Documento">Documento</option>
                    <option value="Seguridad">Seguridad</option>
                    <option value="Negocio">Negocio</option>
                    <option value="Programado">Programado</option>
                </select>
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="Activo" class="form-check-input" role="switch" id="activoSwitch" />
                <label class="form-check-label text-white-50 small" for="activoSwitch">Evento activo (disponible para disparar reglas)</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar Evento</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>
