@model Asistente.Shared.CrearTareaProgramadaRequest
@{
    ViewData["Title"] = "Nueva Tarea Programada";
    var workflows = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Workflows;
}

<div class="mb-4">
    <a asp-action="Index" class="text-secondary text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a tareas</a>
</div>

<h4 class="text-white fw-bold mb-1"><i class="bi bi-calendar-check me-2" style="color:#818cf8;"></i>Programar Tarea Periódica</h4>
<p class="text-secondary small">Ejecute un flujo de trabajo automáticamente según una expresión Cron (Quartz.NET).</p>

<div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);max-width:720px;">
    <div class="card-body p-4">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "Corrija los errores antes de continuar:", new { @class = "text-danger small mb-3" })
            <div class="mb-3">
                <label class="form-label text-white-50 small">Nombre *</label>
                <input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Reindexación Nocturna" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Flujo de trabajo *</label>
                <select asp-for="IdWorkflow" class="form-select bg-dark text-light border-secondary" asp-items="@workflows">
                    <option value="0">Seleccione un flujo...</option>
                </select>
                <span asp-validation-for="IdWorkflow" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label text-white-50 small">Expresión Cron *</label>
                <input asp-for="ExpresionCron" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="0 0 2 * * ?" />
                <span asp-validation-for="ExpresionCron" class="text-danger small"></span>
                <div class="form-text text-secondary">Formato Quartz (6-7 campos). Ejemplos: <span class="font-monospace">0 0 2 * * ?</span> (diario 2 AM), <span class="font-monospace">0 0/30 * * * ?</span> (cada 30 min).</div>
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="Activa" class="form-check-input" role="switch" id="activaSwitch" />
                <label class="form-check-label text-white-50 small" for="activaSwitch">Tarea activa (se programará al reiniciar la API)</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Programar Tarea</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>
