@model IEnumerable<Asistente.Shared.TareaProgramadaDto>
@{
    ViewData["Title"] = "Tareas Programadas";
    var lista = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-calendar-check me-2" style="color:#818cf8;"></i>Tareas Programadas</h4>
        <p class="text-secondary small mb-0">Ejecute flujos de forma periódica con Quartz.NET (expresión Cron)</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nueva Tarea</a>
</div>

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Nombre</th>
                        <th class="text-secondary fw-normal py-3">Flujo</th>
                        <th class="text-secondary fw-normal py-3">Expresión Cron</th>
                        <th class="text-secondary fw-normal py-3">Última ejecución</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                        <th class="text-secondary fw-normal py-3 text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in lista)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3 text-white fw-semibold">@t.Nombre</td>
                            <td><span class="text-white small">@t.NombreWorkflow</span></td>
                            <td><span class="font-monospace text-secondary small">@t.ExpresionCron</span></td>
                            <td class="text-secondary small">@(t.UltimaEjecucion?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>
                                @if (t.Activa)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:20px;">Activa</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(148,163,184,0.15);color:#cbd5e1;border:1px solid rgba(148,163,184,0.25);border-radius:20px;">Inactiva</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                    @if (t.Activa)
                                    {
                                        <form asp-action="Desactivar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.IdTarea" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm py-1 px-2" title="Pausar"><i class="bi bi-pause-fill"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.IdTarea" />
                                            <button type="submit" class="btn btn-outline-success btn-sm py-1 px-2" title="Reanudar"><i class="bi bi-play-fill"></i></button>
                                        </form>
                                    }
                                    <form asp-action="Eliminar" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar la tarea @t.Nombre?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.IdTarea" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!lista.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-5">
                                <i class="bi bi-calendar-check fs-1 d-block mb-2 opacity-25"></i>
                                Aún no hay tareas programadas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="mt-3 text-secondary small">
    <i class="bi bi-info-circle me-1"></i>Las tareas se reprograman al reiniciar la API. Ejemplo Cron: <span class="font-monospace">0 0 2 * * ?</span> = todos los días a las 2:00 AM.
</div>
