@{
    ViewData["Title"] = "Planner Engine";
}
<div class="mb-4">
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-diagram-2 me-2" style="color:#818cf8;"></i>Planner Engine</h4>
    <p class="text-secondary small mb-0">Planifica antes de actuar (ETAPA 18): convierte lenguaje natural en un plan ejecutable y lo delega al Agent Orchestrator.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 mb-4" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-body p-4">
                <h6 class="text-white fw-semibold mb-3">Generar plan desde lenguaje natural</h6>
                <form asp-action="Generar" method="post">
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Objetivo</label>
                        <textarea name="objetivo" class="form-control bg-dark text-white border-secondary" rows="3"
                                  placeholder="Ej: Analiza las ventas del trimestre, compara el cumplimiento con el procedimiento documentado, genera un informe ejecutivo en PDF y resalta los riesgos detectados."></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm px-4 py-2 fw-semibold" style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;">
                        <i class="bi bi-magic me-1"></i> Generar plan
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-body p-4">
                <h6 class="text-white fw-semibold mb-3">Dashboard de planes</h6>
                @{
                    var dash = (Asistente.Shared.PlannerDashboardDto?)ViewBag.Dashboard;
                    dash ??= new Asistente.Shared.PlannerDashboardDto();
                }
                <div class="row text-center g-2">
                    <div class="col-6"><div class="p-3 rounded" style="background:rgba(99,102,241,0.12);"><div class="fs-4 fw-bold text-white">@dash.Total</div><div class="small text-secondary">Total</div></div></div>
                    <div class="col-6"><div class="p-3 rounded" style="background:rgba(16,185,129,0.12);"><div class="fs-4 fw-bold text-white">@dash.Activos</div><div class="small text-secondary">Activos</div></div></div>
                    <div class="col-6"><div class="p-3 rounded" style="background:rgba(34,197,94,0.12);"><div class="fs-4 fw-bold text-white">@dash.Finalizados</div><div class="small text-secondary">Finalizados</div></div></div>
                    <div class="col-6"><div class="p-3 rounded" style="background:rgba(239,68,68,0.12);"><div class="fs-4 fw-bold text-white">@dash.Fallidos</div><div class="small text-secondary">Fallidos</div></div></div>
                </div>
                <div class="mt-3 small text-secondary">
                    Tiempo promedio: <span class="text-white">@(dash.TiempoPromedioMs / 1000.0)s</span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (dash.Planes.Any())
{
    <div class="card border-0 mt-2" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
        <div class="card-body p-4">
            <h6 class="text-white fw-semibold mb-3">Planes recientes</h6>
            <div class="table-responsive">
                <table class="table table-sm table-dark align-middle">
                    <thead><tr><th>#</th><th>Objetivo</th><th>Estado</th><th>Pasos</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in dash.Planes)
                    {
                        <tr>
                            <td>@p.IdPlan</td>
                            <td class="text-truncate" style="max-width:320px;">@p.Objetivo</td>
                            <td>@p.Estado</td>
                            <td>@p.Pasos.Count</td>
                            <td><a asp-action="Detalle" asp-route-id="@p.IdPlan" class="btn btn-sm btn-outline-light">Ver</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
