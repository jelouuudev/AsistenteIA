@{
    ViewData["Title"] = "Visualizador de planes";
}
@if (ViewBag.Plan is Asistente.Shared.PlanDto plan)
{
    <div class="mb-3">
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-diagram-2 me-2" style="color:#818cf8;"></i>Plan #@plan.IdPlan</h4>
        <p class="text-secondary small mb-0">@plan.Objetivo</p>
    </div>

    @if (ViewBag.Simulacion is Asistente.Shared.SimulacionPlanDto sim)
    {
        <div class="card border-0 mb-3 @(sim.Validacion.Valido ? "border-success" : "border-danger")" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid @(sim.Validacion.Valido ? "rgba(16,185,129,0.5)" : "rgba(239,68,68,0.5)");">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-2 @(sim.Validacion.Valido ? "text-success" : "text-danger")">
                    🔍 Simulación en seco — @(sim.Validacion.Valido ? "Plan VÁLIDO, listo para ejecutar" : "Plan INVÁLIDO, corrija antes de ejecutar")
                </h6>
                <div class="row g-2 small">
                    <div class="col-md-4">
                        <div class="text-secondary">Participantes</div>
                        @foreach (var p in sim.Participantes) { <span class="badge bg-info text-dark me-1">@p</span> }
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary">Herramientas</div>
                        @foreach (var h in sim.Herramientas) { <span class="badge bg-secondary me-1">@h</span> }
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary">Tiempo estimado (CPU)</div>
                        <span class="text-white">@(sim.TiempoEstimadoSegundos / 60) min aprox.</span>
                    </div>
                </div>
                @if (sim.Validacion.Errores.Any())
                {
                    <div class="mt-2 small text-danger">Errores: @string.Join(" | ", sim.Validacion.Errores)</div>
                }
                @if (sim.Validacion.Riesgos.Any())
                {
                    <div class="mt-1 small text-warning">Riesgos: @string.Join(" | ", sim.Validacion.Riesgos)</div>
                }
                @if (sim.Validacion.Advertencias.Any())
                {
                    <div class="mt-1 small text-info">Advertencias: @string.Join(" | ", sim.Validacion.Advertencias)</div>
                }
                <div class="mt-1 small text-secondary">El plan NO se ha ejecutado (Regla 3: el Planner nunca ejecuta acciones directamente).</div>
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 mb-3" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                <div class="card-body p-4">
                    <h6 class="text-white fw-semibold mb-3">Grafo de ejecución (DAG)</h6>
                    <div class="d-flex flex-column gap-2">
                    @foreach (var paso in plan.Pasos)
                    {
                        <div class="p-3 rounded @EstadoClase(paso.Estado)" style="border:1px solid rgba(255,255,255,0.1);">
                            <div class="d-flex justify-content-between">
                                <span class="fw-semibold text-white">@paso.Orden. @paso.Nombre</span>
                                <span class="badge bg-secondary">@paso.Tipo</span>
                            </div>
                            <div class="small text-secondary">@paso.Descripcion</div>
                            <div class="small mt-1"><span class="text-info">Estado:</span> <span class="text-white">@paso.Estado</span> @if(paso.Intentos>0){<span class="text-warning">(reintentos: @paso.Intentos)</span>}</div>
                            @if (!string.IsNullOrWhiteSpace(paso.Resultado))
                            {
                                <div class="small mt-1 text-white-50">→ @paso.Resultado</div>
                            }
                        </div>
                    }
                    </div>
                    @if (plan.Dependencias.Any())
                    {
                        <hr class="border-secondary" />
                        <div class="small text-secondary">Dependencias:
                        @foreach (var d in plan.Dependencias)
                        { <span class="badge bg-dark text-white me-1">@d.StepOrigen → @d.StepDestino</span> }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 mb-3" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                <div class="card-body p-4">
                    <h6 class="text-white fw-semibold mb-3">Acciones</h6>
                    <div class="d-grid gap-2">
                        @if (plan.Estado == "Borrador" || plan.Estado == "Validado" || plan.Estado == "Pendiente" || plan.Estado == "EnEsperaAprobacion")
                        {
                            <form asp-action="Ejecutar" method="post" asp-route-id="@plan.IdPlan">
                                <button type="submit" class="btn btn-sm btn-success w-100"
                                        onclick="this.disabled=true; this.textContent='⏳ Ejecutando...'; this.form.submit(); return false;">
                                    ▶ Ejecutar
                                </button>
                            </form>
                        }
                        <a asp-action="Simular" asp-route-id="@plan.IdPlan" class="btn btn-sm btn-outline-info">🔍 Simular</a>
                        @if (plan.Estado == "EnEjecucion" || plan.Estado == "IniciandoEjecucion")
                        {
                            <form asp-action="Cancelar" method="post" asp-route-id="@plan.IdPlan">
                                <button class="btn btn-sm btn-danger w-100">⛔ Cancelar</button>
                            </form>
                        }
                        <a asp-action="Index" class="btn btn-sm btn-outline-light">← Dashboard</a>
                    </div>
                    <hr class="border-secondary" />
                    <div class="small text-secondary">Estado: <span class="text-white">@plan.Estado</span></div>
                    @if (plan.RequiereAprobacion) { <div class="small text-warning">Requiere aprobación @(plan.Aprobado ? "(otorgada)" : "(pendiente)")</div> }
                    @if (!string.IsNullOrWhiteSpace(plan.IdExecution)) { <div class="small text-secondary">Ejecución Orchestrator: <span class="text-white">@plan.IdExecution</span></div> }
                    @if (plan.TiempoTotalMs.HasValue) { <div class="small text-secondary">Tiempo: <span class="text-white">@(plan.TiempoTotalMs/1000.0)s</span></div> }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(plan.Razonamiento))
            {
                <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                    <div class="card-body p-4">
                        <h6 class="text-white fw-semibold mb-2">Razonamiento del Planner</h6>
                        <div class="small text-white-50" style="white-space:pre-wrap;">@plan.Razonamiento</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (plan.Logs.Any())
    {
        <div class="card border-0 mt-2" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-body p-4">
                <h6 class="text-white fw-semibold mb-3">Auditoría (PlanExecutionLog)</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-dark">
                        <thead><tr><th>Evento</th><th>Detalle</th><th>Fecha</th></tr></thead>
                        <tbody>
                        @foreach (var l in plan.Logs)
                        {
                            <tr><td class="text-info">@l.Evento</td><td>@l.Detalle</td><td class="small text-secondary">@l.Fecha</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (plan.Estado == "EnEjecucion" || plan.Estado == "IniciandoEjecucion")
    {
        <meta http-equiv="refresh" content="10" />
        <div class="text-center text-secondary small mt-2">Plan en ejecución… esta página se actualiza sola cada 10 segundos.</div>
    }
}
else
{
    <div class="alert alert-danger">No se pudo cargar el plan.</div>
}

@functions {
    string EstadoClase(string estado) => estado switch
    {
        "Completado" => "bg-success bg-opacity-10",
        "EnEjecucion" => "bg-primary bg-opacity-10",
        "Error" => "bg-danger bg-opacity-10",
        "Pendiente" => "bg-secondary bg-opacity-10",
        _ => "bg-dark"
    };
}
