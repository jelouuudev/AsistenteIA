@{
    ViewData["Title"] = "Agent Orchestrator";
}
<div class="mb-4">
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-diagram-3 me-2" style="color:#818cf8;"></i>Agent Orchestrator</h4>
    <p class="text-secondary small mb-0">Coordinación multi-agente con Execution Graph, trazabilidad y control de profundidad</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;">
        @TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;">
        @TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 mb-4" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-body p-4">
                <h6 class="text-white fw-semibold mb-3">Ejecutar solicitud orquestada</h6>
                <form asp-action="Ejecutar" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Agente principal</label>
                        <select name="idAgentePrincipal" class="form-select bg-dark text-white border-secondary" style="border-radius:10px;">
                            <option value="0">-- Seleccione --</option>
                            @foreach (var a in (IEnumerable<AgenteSimpleDto>)(ViewBag.Agentes ?? new List<AgenteSimpleDto>()))
                            {
                                <option value="@a.IdAsistente">@a.Nombre (@a.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Solicitud (una sola petición)</label>
                        <textarea name="pregunta" rows="3" class="form-control bg-dark text-white border-secondary" style="border-radius:10px;" placeholder="Ej: Analiza las ventas del mes, prepara un resumen ejecutivo y compáralo con el procedimiento del manual."></textarea>
                    </div>
                    <button type="submit" id="btnEjecutar" class="btn btn-sm px-4 py-2 fw-semibold" style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;">
                        <i class="bi bi-play-fill me-1"></i> Ejecutar Orchestrator
                    </button>
                    <span id="ejecutando" class="text-secondary small ms-2 d-none"><span class="spinner-border spinner-border-sm me-1"></span>Ejecutando (puede tardar 1-2 min en CPU)…</span>
                </form>
            </div>
        </div>

        <div id="loadingOverlay" class="d-none position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background:rgba(15,23,42,0.7);z-index:9999;">
            <div class="text-center">
                <div class="spinner-border text-light" style="width:3rem;height:3rem;"></div>
                <p class="text-white mt-3">Ejecutando Agent Orchestrator…<br /><span class="small text-secondary">La coordinación multi-agente puede tardar 1-2 minutos en CPU.</span></p>
            </div>
        </div>

        @if (ViewBag.Resultado != null)
        {
            var res = (AgentExecutionResultDto)ViewBag.Resultado;
            <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(129,140,248,0.3);">
                <div class="card-body p-4">
                    <h6 class="text-white fw-semibold mb-2">Respuesta consolidada</h6>
                    <p class="text-white-50 small mb-2">@res.CantidadAgentes agente(s) · profundidad @res.ProfundidadAlcanzada · @res.TiempoTotalMs ms</p>
                    <div class="border rounded p-3 bg-dark text-white" style="white-space:pre-wrap;max-height:360px;overflow:auto;">@res.RespuestaFinal</div>
                    <h6 class="text-white fw-semibold mt-3 mb-2">Trazas de ejecución</h6>
                    <ul class="small text-secondary">
                        @foreach (var p in res.Pasos)
                        {
                            <li><span class="text-info">[@p.Estado]</span> @p.NombreAgente — @p.Accion (@p.TiempoMs ms)</li>
                        }
                    </ul>
                    <a asp-action="Trazas" asp-route-id="@res.IdExecution" class="btn btn-sm btn-outline-light">Ver traza completa</a>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
            <div class="card-body p-4">
                <h6 class="text-white fw-semibold mb-3">Dashboard de ejecuciones</h6>
                @if (ViewBag.Dashboard is object)
                {
                    var d = (System.Text.Json.JsonElement)ViewBag.Dashboard;
                    <p class="text-secondary small mb-1">Total: <span class="text-white">@d.GetProperty("totalEjecuciones").GetInt32()</span> ·
                        Completadas: <span class="text-success">@d.GetProperty("completadas").GetInt32()</span> ·
                        Con error: <span class="text-danger">@d.GetProperty("conError").GetInt32()</span></p>
                    <div class="table-responsive" style="max-height:340px;overflow:auto;">
                        <table class="table table-sm table-dark align-middle">
                            <thead><tr><th>#</th><th>Principal</th><th>Agentes</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var e in d.GetProperty("ejecuciones").EnumerateArray())
                            {
                                <tr>
                                    <td>@e.GetProperty("idExecution").GetInt32()</td>
                                    <td>@e.GetProperty("agentePrincipal").GetString()</td>
                                    <td>@e.GetProperty("cantidadAgentes").GetInt32()</td>
                                    <td><span class="badge bg-secondary">@e.GetProperty("estado").GetString()</span></td>
                                    <td><a asp-action="Trazas" asp-route-id="@e.GetProperty("idExecution").GetInt32()" class="btn btn-sm btn-outline-info">Trazas</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-secondary small">Sin ejecuciones registradas.</p>
                }
            </div>
        </div>
        <div class="mt-3">
            <a asp-action="Reglas" class="btn btn-sm btn-outline-light"><i class="bi bi-link-45deg me-1"></i> Administrar reglas de colaboración</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.querySelector('form[asp-action="Ejecutar"], form[action*="Ejecutar"]');
            if (!form) return;
            form.addEventListener('submit', function () {
                var btn = document.getElementById('btnEjecutar');
                var overlay = document.getElementById('loadingOverlay');
                if (btn) { btn.disabled = true; btn.classList.add('opacity-50'); }
                if (overlay) overlay.classList.remove('d-none');
            });
        });
    </script>
}
