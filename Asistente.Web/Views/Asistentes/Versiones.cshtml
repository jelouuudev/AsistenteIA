@model IEnumerable<Asistente.Shared.AgenteVersionDto>
@{
    ViewData["Title"] = "Versiones del Agente";
    var asistenteId = (int)(ViewBag.AsistenteId ?? 0);
    var asistenteNombre = (string)(ViewBag.AsistenteNombre ?? "");
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm me-3" style="background:rgba(255,255,255,0.05);color:#94a3b8;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-tag me-2" style="color:#5eead4;"></i>Versiones: @asistenteNombre</h4>
        <p class="text-secondary small mb-0">Historial de cambios del agente</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-end mb-3">
            <form asp-action="CrearVersion" asp-route-id="@asistenteId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm px-4 py-2 fw-semibold"
                        style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
                    <i class="bi bi-plus-lg me-1"></i> Guardar Versión Actual
                </button>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                <div class="card-body text-center py-5">
                    <i class="bi bi-tag fs-1 d-block mb-2 opacity-25 text-secondary"></i>
                    <p class="text-secondary">No hay versiones guardadas.</p>
                    <p class="text-secondary small">Usa "Guardar Versión Actual" para crear un punto de restauración.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var v in Model)
            {
                <div class="card border-0 mb-3" style="background:rgba(30,41,59,0.6);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge" style="background:rgba(99,102,241,0.2);color:#a5b4fc;border:1px solid rgba(99,102,241,0.3);border-radius:20px;font-size:0.85rem;padding:5px 14px;">
                                    <i class="bi bi-tag me-1"></i>@("v" + v.Version)
                                </span>
                                <span class="badge ms-2" style="background:rgba(129,140,248,0.15);color:#a5b4fc;border:1px solid rgba(129,140,248,0.25);border-radius:20px;font-size:0.75rem;padding:4px 10px;">
                                    <i class="bi bi-cpu me-1"></i>@v.ModeloIA
                                </span>
                                @if (v.Estado == Asistente.Domain.Entities.EstadoAgente.Activo)
                                {
                                    <span class="badge ms-2" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25);border-radius:20px;font-size:0.75rem;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.4rem;"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge ms-2" style="background:rgba(239,68,68,0.12);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:20px;font-size:0.75rem;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.4rem;"></i>Inactivo
                                    </span>
                                }
                            </div>
                            <form asp-action="RestaurarVersion" asp-route-id="@asistenteId" asp-route-idVersion="@v.IdAgenteVersion" method="post"
                                  onsubmit="return confirm('¿Restaurar @("v" + v.Version)? El agente volverá a la configuración de esta versión.')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25);border-radius:8px;">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                </button>
                            </form>
                        </div>

                        @if (!string.IsNullOrEmpty(v.PromptSistema))
                        {
                            <div class="mb-3 p-3" style="background:rgba(0,0,0,0.2);border-radius:8px;border-left:3px solid #6366f1;">
                                <div class="text-secondary small mb-1"><i class="bi bi-chat-square-text me-1"></i>Prompt del sistema:</div>
                                <div class="text-light" style="font-size:0.85rem;white-space:pre-wrap;max-height:80px;overflow:hidden;">@(v.PromptSistema.Length > 200 ? v.PromptSistema.Substring(0, 200) + "..." : v.PromptSistema)</div>
                            </div>
                        }

                        <div class="d-flex gap-4 text-secondary small">
                            <span><i class="bi bi-calendar3 me-1"></i>@v.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                            <span><i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(v.UsuarioCreacion) ? "Sistema" : v.UsuarioCreacion)</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
