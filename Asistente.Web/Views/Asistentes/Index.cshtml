@model IEnumerable<Asistente.Shared.AsistenteDto>
@{
    ViewData["Title"] = "Asistentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-robot me-2" style="color:#818cf8;"></i>Asistentes</h4>
        <p class="text-secondary small mb-0">Administración de asistentes IA</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-sm px-3 py-2 fw-semibold me-2"
       style="background:rgba(45,212,191,0.15);color:#5eead4;border:1px solid rgba(45,212,191,0.25);border-radius:10px;">
        <i class="bi bi-grid-1x2 me-1"></i> Dashboard
    </a>
    <a asp-action="Crear" class="btn btn-sm px-4 py-2 fw-semibold"
       style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Agente
    </a>
</div>

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Código</th>
                        <th class="text-secondary fw-normal py-3">Nombre</th>
                        <th class="text-secondary fw-normal py-3">Descripción</th>
                        <th class="text-secondary fw-normal py-3">Modelo IA</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                        <th class="text-secondary fw-normal py-3">Versión</th>
                        <th class="text-secondary fw-normal py-3">Creado</th>
                        <th class="text-secondary fw-normal py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <span class="badge" style="background:rgba(99,102,241,0.15);color:#a5b4fc;border:1px solid rgba(99,102,241,0.25);border-radius:6px;font-size:0.72rem;font-family:monospace;">@a.Codigo</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle"
                                         style="width:36px;height:36px;background:linear-gradient(135deg,#6366f1,#a855f7);font-weight:bold;font-size:0.9rem;">
                                        @a.Nombre[0].ToString().ToUpper()
                                    </div>
                                    <span class="fw-semibold text-white">@a.Nombre</span>
                                </div>
                            </td>
                            <td class="text-secondary small">@(a.Descripcion?.Length > 50 ? a.Descripcion[..50] + "..." : a.Descripcion ?? "—")</td>
                            <td><span class="badge" style="background:rgba(129,140,248,0.2);color:#a5b4fc;border:1px solid rgba(129,140,248,0.3);border-radius:20px;font-size:0.72rem;padding:3px 10px;">@a.ModeloIA</span></td>
                            <td>
                                @{
                                    string colorEstado = a.Activo ? "rgba(16,185,129,0.2);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)" : "rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.25)";
                                    string textoEstado = a.Activo ? "Activo" : "Inactivo";
                                }
                                <span class="badge" style="background:@colorEstado;border-radius:20px;padding:4px 10px;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>@textoEstado
                                </span>
                            </td>
                            <td class="text-secondary">@("v" + a.Version)</td>
                            <td class="text-secondary small">@a.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end px-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Editar" asp-route-id="@a.IdAsistente"
                                       class="btn btn-sm" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.2);border-radius:8px;" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="Prompts" asp-action="Index" asp-route-asistenteId="@a.IdAsistente"
                                       class="btn btn-sm" style="background:rgba(168,85,247,0.15);color:#c084fc;border:1px solid rgba(168,85,247,0.2);border-radius:8px;" title="Ver Prompts">
                                        <i class="bi bi-file-text"></i>
                                    </a>
                                    <a asp-action="Versiones" asp-route-id="@a.IdAsistente"
                                       class="btn btn-sm" style="background:rgba(45,212,191,0.15);color:#5eead4;border:1px solid rgba(45,212,191,0.2);border-radius:8px;" title="Versiones">
                                        <i class="bi bi-tag"></i>
                                    </a>
                                    <form asp-action="Duplicar" asp-route-id="@a.IdAsistente" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Duplicar al agente @a.Nombre?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm"
                                                style="background:rgba(96,165,250,0.15);color:#93c5fd;border:1px solid rgba(96,165,250,0.2);border-radius:8px;" title="Duplicar">
                                            <i class="bi bi-files"></i>
                                        </button>
                                    </form>
                                    @if (a.Activo)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@a.IdAsistente" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Desactivar al agente @a.Nombre?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm"
                                                    style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;" title="Desactivar">
                                                <i class="bi bi-toggle-off"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@a.IdAsistente" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm"
                                                    style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2);border-radius:8px;" title="Activar">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">
                                <i class="bi bi-robot fs-1 d-block mb-2 opacity-25"></i>
                                No hay asistentes registrados. <a asp-action="Crear" class="text-decoration-none" style="color:#818cf8;">Cree el primero.</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
