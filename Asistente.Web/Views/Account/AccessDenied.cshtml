@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Denegado - Asistente IA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            max-width: 480px;
            width: 100%;
            padding: 3rem;
        }
        .icon-denied {
            font-size: 4rem;
            color: #ef4444;
        }
    </style>
</head>
<body>
    <div class="glass-card text-center">
        <i class="bi bi-shield-x icon-denied mb-3 d-block"></i>
        <h2 class="text-white fw-bold mb-2">Acceso Denegado</h2>
        <p class="text-secondary mb-4">No tienes permisos para acceder a esta sección del sistema.</p>
        <a asp-controller="Chat" asp-action="Index" class="btn btn-outline-light me-2">
            <i class="bi bi-house me-1"></i> Inicio
        </a>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">
            <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
        </a>
    </div>
</body>
</html>
