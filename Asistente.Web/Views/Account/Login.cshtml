@model Asistente.Shared.LoginRequest
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Asistente IA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
        }

        body::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
            top: 10%;
            left: 15%;
            z-index: 0;
        }

        body::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(236, 72, 153, 0.1) 0%, transparent 70%);
            bottom: 10%;
            right: 15%;
            z-index: 0;
        }

        .login-container {
            z-index: 1;
            width: 100%;
            max-width: 450px;
            padding: 15px;
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
        }

        .brand-logo {
            font-size: 3rem;
            background: linear-gradient(to right, #818cf8, #c084fc, #f472b6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: pulse 3s infinite;
        }

        .form-control-custom {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f1f5f9;
            border-radius: 12px;
            padding: 12px 16px;
            transition: all 0.2s ease;
        }

        .form-control-custom:focus {
            background: rgba(15, 23, 42, 0.8);
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.25);
            color: #fff;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            border: none;
            color: white;
            padding: 12px;
            border-radius: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.5);
            background: linear-gradient(135deg, #4f46e5 0%, #9333ea 100%);
        }

        .text-muted-custom {
            color: #94a3b8;
        }

        .error-message {
            background: rgba(239, 68, 68, 0.15);
            border-left: 4px solid #ef4444;
            color: #fca5a5;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <div class="mb-2">
                    <i class="bi bi-robot brand-logo"></i>
                </div>
                <h3 class="text-white fw-bold mb-1">Asistente Inteligente</h3>
                <p class="text-muted-custom">Introduce tus credenciales para acceder</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-message">
                    <div asp-validation-summary="All" class="text-danger list-unstyled"></div>
                </div>
            }

            <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label text-white fw-medium small mb-2">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 text-muted-custom"><i class="bi bi-person"></i></span>
                        <input asp-for="Usuario" class="form-control form-control-custom border-start-0" placeholder="Ej: admin" required autofocus autocomplete="off" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-white fw-medium small mb-2">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 text-muted-custom"><i class="bi bi-lock"></i></span>
                        <input asp-for="Contrasena" type="password" class="form-control form-control-custom border-start-0" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-gradient w-100 mb-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                </button>
            </form>

            <div class="text-center text-muted-custom small mt-4">
                Asistente Inteligente Empresarial &copy; 2026
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
