@model IEnumerable<Asistente.Shared.ConsultaPlantillaDto>
@{
    ViewData["Title"] = "Plantillas de Consulta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-0"><i class="bi bi-file-earmark-code me-2" style="color:#818cf8;"></i>Plantillas de Consulta</h4>
        <p class="text-secondary small mb-0">Catálogo de consultas parametrizadas reutilizables</p>
    </div>
    <a asp-action="Crear" class="btn btn-sm px-4 py-2 fw-semibold"
       style="background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:white;border-radius:10px;box-shadow:0 4px 12px rgba(99,102,241,0.3);">
        <i class="bi bi-plus-lg me-1"></i> Nueva Plantilla
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                <thead style="background:rgba(0,0,0,0.2);">
                    <tr class="border-bottom border-secondary">
                        <th class="text-secondary fw-normal py-3 px-4">Nombre</th>
                        <th class="text-secondary fw-normal py-3">Conexión</th>
                        <th class="text-secondary fw-normal py-3">Consulta SQL</th>
                        <th class="text-secondary fw-normal py-3">Estado</th>
                        <th class="text-secondary fw-normal py-3 text-end px-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="border-bottom" style="border-color:rgba(255,255,255,0.05) !important;">
                            <td class="px-4 py-3">
                                <span class="fw-semibold text-white">@p.Nombre</span>
                                @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                                {
                                    <div class="text-secondary" style="font-size:0.75rem;">@p.Descripcion</div>
                                }
                            </td>
                            <td class="text-secondary small">@(p.NombreConexion ?? "Sin asignar")</td>
                            <td><code class="text-white small" style="background:rgba(0,0,0,0.3);padding:2px 8px;border-radius:6px;">@p.ConsultaSql</code></td>
                            <td>
                                @if (p.Activa)
                                {
                                    <span class="badge" style="background:rgba(16,185,129,0.2);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.25);border-radius:20px;padding:4px 10px;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Inactiva
                                    </span>
                                }
                            </td>
                            <td class="text-end px-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Editar" asp-route-id="@p.IdPlantilla"
                                       class="btn btn-sm" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.2);border-radius:8px;" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (p.Activa)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@p.IdPlantilla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;" title="Desactivar">
                                                <i class="bi bi-toggle-off"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@p.IdPlantilla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2);border-radius:8px;" title="Activar">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Eliminar" asp-route-id="@p.IdPlantilla" method="post" class="d-inline"
                                          onsubmit="return confirm('Eliminar la plantilla @p.Nombre?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);border-radius:8px;" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-secondary py-5">
                                <i class="bi bi-file-earmark-code fs-1 d-block mb-2 opacity-25"></i>
                                No hay plantillas registradas. <a asp-action="Crear" class="text-decoration-none" style="color:#818cf8;">Cree la primera.</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
