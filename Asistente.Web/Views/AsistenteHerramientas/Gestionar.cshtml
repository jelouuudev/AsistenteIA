@model List<Asistente.Shared.HerramientaDto>
@{
    ViewData["Title"] = "Gestionar Herramientas del Asistente";
    var asistente = (Asistente.Shared.AsistenteDto?)ViewBag.Asistente;
    var asociadas = (System.Collections.Generic.HashSet<int>)ViewBag.AsociadasIds;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small mb-2 d-inline-block" style="color:#818cf8;"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    <h4 class="text-white fw-bold mb-0"><i class="bi bi-tools me-2" style="color:#818cf8;"></i>Herramientas de @(asistente?.Nombre ?? "Asistente")</h4>
    <p class="text-secondary small mb-0">Active o desactive las herramientas que este asistente puede utilizar</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0" style="background:rgba(30,41,59,0.6);backdrop-filter:blur(12px);border-radius:16px;border:1px solid rgba(255,255,255,0.07);">
    <div class="card-body p-4">
        <div class="row g-3">
            @foreach (var h in Model)
            {
                bool estaAsociada = asociadas.Contains(h.IdHerramienta);
                <div class="col-md-6">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded" style="background:rgba(15,23,42,0.5);border:1px solid rgba(255,255,255,0.06);">
                        <div class="d-flex align-items-center gap-2">
                            <div class="d-flex align-items-center justify-content-center rounded-circle"
                                 style="width:34px;height:34px;background:linear-gradient(135deg,#6366f1,#a855f7);font-weight:bold;font-size:0.85rem;">
                                <i class="bi bi-gear"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-white small">@h.Nombre</div>
                                <div class="small text-secondary font-monospace">@h.Codigo</div>
                            </div>
                        </div>
                        @if (estaAsociada)
                        {
                            <form asp-action="Desasociar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idAsistente" value="@asistente?.IdAsistente" />
                                <input type="hidden" name="idHerramienta" value="@h.IdHerramienta" />
                                <button type="submit" class="btn btn-sm" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:20px;">
                                    <i class="bi bi-check-circle me-1"></i> Autorizada
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Asociar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idAsistente" value="@asistente?.IdAsistente" />
                                <input type="hidden" name="idHerramienta" value="@h.IdHerramienta" />
                                <input type="hidden" name="activa" value="true" />
                                <button type="submit" class="btn btn-sm" style="background:rgba(148,163,184,0.12);color:#cbd5e1;border:1px solid rgba(148,163,184,0.2);border-radius:20px;">
                                    <i class="bi bi-plus-circle me-1"></i> Asociar
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="col-12 text-center text-secondary py-5">
                    <i class="bi bi-tools fs-1 d-block mb-2 opacity-25"></i>
                    No hay herramientas registradas.
                </div>
            }
        </div>
    </div>
</div>
