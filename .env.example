# EJEMPLO de variables de entorno para AsistenteIA (ETAPA 15)
# COPIAR a .env y AJUSTAR. NO commitear .env (está en .gitignore).
# El .env real con secretos vive solo en el servidor de producción.

# --- Entorno ---
ENVIRONMENT=Production

# --- Puertos ---
CHROMA_PORT=8000
SQL_PORT=1433
OLLAMA_PORT=11434
API_PORT=5298
WEB_PORT=5206

# --- SQL Server ---
# En producción usar una connection string completa (no Trusted_Connection en container).
# Ejemplo con usuario sa:
SQL_SA_PASSWORD=CambiaEstePassword123!
API_DB_CONNECTION=Server=mssql,1433;Database=AsistenteIA;User Id=sa;Password=CambiaEstePassword123!;TrustServerCertificate=True;

# --- Ollama ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:7b
EMBEDDING_MODEL=nomic-embed-text

# --- JWT (generar un secreto >= 32 chars, único por entorno) ---
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CARACTERES

# --- Chroma ---
CHROMA_AUTH=chroma
