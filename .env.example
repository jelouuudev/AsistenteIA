# EJEMPLO de variables de entorno para AsistenteIA (ETAPA 15)
# COPIAR a .env y AJUSTAR. NO commitear .env (está en .gitignore).
# El .env real con secretos vive solo en el servidor de producción.

# --- Entorno ---
ENVIRONMENT=Production

# --- Puertos ---
CHROMA_PORT=8000
SQL_PORT=1433
OLLAMA_PORT=11434
API_PORT=5298
WEB_PORT=5206

# --- SQL Server ---
# En producción usar una connection string completa (no Trusted_Connection en container).
# Ejemplo con usuario sa:
SQL_SA_PASSWORD=CambiaEstePassword123!
API_DB_CONNECTION=Server=mssql,1433;Database=AsistenteIA;User Id=sa;Password=CambiaEstePassword123!;TrustServerCertificate=True;

# --- Ollama ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:7b
EMBEDDING_MODEL=nomic-embed-text

# --- JWT (generar un secreto >= 32 chars, único por entorno) ---
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CARACTERES

# --- Chroma ---
CHROMA_AUTH=chroma

# --- Cifrado del contenido de memoria (ETAPA 21) ---
# El contenido de MemoryRecords y MemoryVersions se guarda cifrado con AES.
# Generar uno propio: openssl rand -hex 32
#
# IMPORTANTE: NO cambiarlo una vez que existan memorias cifradas. Cambiarlo no
# destruye datos, pero deja el contenido de esas memorias ilegible y solo se
# recupera con la clave anterior o desde un respaldo.
# Si se omite, se cae sobre JWT_SECRET (funciona, pero mezcla dos usos).
MEMORIA_CLAVE_CIFRADO=CAMBIAR_POR_64_CARACTERES_HEXADECIMALES_PROPIOS
