## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Others
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publishsettings
node_modules/

# ============================================================
# ETAPA 15 - Seguridad: NO commitear secretos ni config sensible
# ============================================================
# Archivos de entorno con secretos reales (usar .env.example en el repo)
.env
.env.*
!.env.example

# Connection strings / claves locales
appsettings.Local.json
appsettings.local.json
*appsettings.Secrets.json

# Claves, certificados y credenciales
*.key
*.pem
secrets.json
secrets/

# Backups y respaldos generados
/backups/
*.bak
*.trn

# Documentos cargados por los usuarios (no son código fuente)
AsistenteIA_Documentos/

# ============================================================
# Carpeta ajena al proyecto (no es parte de AsistenteIA)
# ============================================================
backend-red-salud/
# Credenciales y secretos
.env
.env.bak.*
*.env.local
appsettings.Development.json
appsettings.Production.json

# Claves y certificados
*.pfx
*.key
*.pem
*.crt

# Archivos temporales de Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
logs/
*.log

# Bases de datos locales (nunca commitear datos)
*.db
*.sqlite
*.sqlite-journal
